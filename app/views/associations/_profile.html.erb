<h2><%= organization.name %></h2><% if organization.logo.attached? %><%= image_tag media_path(organization.logo.attachment), alt: "Logo de #{organization.name}", width: 160, height: 160, class: "organization-logo" %><% end %><p><%= organization.public_location %></p><%= plain_paragraphs(organization.description) %><% if organization.verified? %><p class="badge">Organisation vérifiée</p><% end %>
