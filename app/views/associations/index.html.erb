<section class="container section prose"><h1>Les associations</h1><p>Découvrez les associations vérifiées et leurs projets d’entraide.</p><% @organizations.each do |organization| %><article class="card"><h2><%= link_to organization.name, association_path(organization) %></h2><p><%= organization.public_location %></p><p><%= truncate(organization.description, length: 250) %></p></article><% end %><% if @organizations.empty? %><p>Les premières associations seront présentées après vérification.</p><% end %><p><%= link_to "Proposer mon association", account_organizations_path, class: "btn btn-primary" %> <%= link_to "Voyage solidaire", volunteer_missions_path if FeatureFlag.voyage_enabled? %></p></section>
