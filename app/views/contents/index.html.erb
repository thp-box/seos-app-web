<section class="container section"><span class="eyebrow">La vie de la communauté</span><h1>Le journal SEOS</h1><div class="card-grid"><% @articles.each do |article| %><article class="card"><h2><%= link_to article.title, article_path(article.slug) %></h2><p><%= article.summary %></p><time><%= l article.published_at.to_date %></time></article><% end %></div><% if @articles.empty? %><p>Les premiers articles arrivent bientôt.</p><% end %></section>
