<div class="menu-panel profile-menu">
  <div class="profile-menu-heading"><span class="nav-avatar" aria-hidden="true"><% if current_user.profile&.avatar&.attached? %><%= image_tag media_path(current_user.profile.avatar.attachment), alt: "" %><% else %><%= public_name(current_user).first.upcase %><% end %></span><div><strong><%= public_name(current_user) %></strong><span class="profile-menu-balance" data-notification-balance><%= PointAccount.find_by(user: current_user)&.balance || 0 %> Points Services</span></div></div>
  <% entries = [["Tableau de bord", account_root_path, "home", nil], ["Messagerie", account_service_requests_path, "chat", "messages"], ["Mes quêtes", account_community_path, "check", "quests"], ["Mon portefeuille", account_points_path, "wallet", "wallet"], ["Mes favoris", account_favorites_path, "heart", "favorites"], ["Profil et paramètres", edit_account_profile_path, "settings", ["profile", "security", "privacy"]]] %>
  <nav aria-label="Accès rapide à mon compte"><% entries.each do |label, path, icon, category| %><%= link_to path, class: "profile-menu-link", aria: { current: ("page" if current_page?(path)) } do %><span class="profile-menu-icon" aria-hidden="true"><%= profile_menu_icon(icon) %></span><span><%= label %></span><%= notification_badge(category) if category %><% end %><% end %>
    <%= link_to account_notifications_path, class: "profile-menu-link", aria: { current: ("page" if controller_path == "account/notifications") } do %><span class="profile-menu-icon" aria-hidden="true"><%= profile_menu_icon("bell") %></span><span>Toutes mes notifications</span><%= notification_badge("all") %><% end %>
  </nav>
  <% if policy(:administration).show? %><%= link_to "Studio admin", admin_root_path, class: "profile-menu-link" %><% end %>
  <div class="profile-menu-logout"><%= button_to destroy_user_session_path, method: :delete, class: "profile-menu-link" do %><span class="profile-menu-icon" aria-hidden="true"><%= profile_menu_icon("logout") %></span><span>Se déconnecter</span><% end %></div>
</div>
