<div class="card"><h3><%= mission.persisted? ? "Modifier la mission" : "Préparer une mission" %></h3><p>Indiquez la contribution en Points Services par jour. Ce formulaire ne déclenche aucun transfert de points. Seul le super-admin peut publier une annonce monde.</p>
<%= form_with model: mission, scope: :mission, url: url, method: method, multipart: true do |form| %><%= hidden_field_tag :operation, "mission", id: nil %><%= hidden_field_tag :record_id, mission.id, id: nil %><%= hidden_field_tag :organization_id, mission.organization_id, id: nil %>
<% prefix = "mission-#{mission.persisted? ? 'record' : 'new'}-#{mission.id || mission.organization_id}-" %>
<% { title: "Titre", description: "Présentation publique", country_code: "Pays (code à deux lettres, ex. FR)", region: "Région", public_location: "Localisation publique (sans adresse précise)", private_address: "Adresse précise (privée, communiquée après acceptation)", languages: "Langues parlées", accommodation: "Hébergement proposé", meals: "Repas proposés" }.each do |field, label| %><%= input_field form, field, label, type: %i[description accommodation meals].include?(field) ? :text_area : :text_field, id: prefix + field.to_s %><% end %>
<%= input_field form, :starts_on, "Début de la mission", type: :date_field, id: prefix + "starts_on" %><%= input_field form, :ends_on, "Fin de la mission", type: :date_field, id: prefix + "ends_on" %>
<% { minimum_stay_days: ["Séjour minimal en jours", 1, 365], help_hours_per_day: ["Heures d’aide par jour", 1, 8], days_off_per_week: ["Jours libres par semaine", 1, 6], volunteer_capacity: ["Nombre de bénévoles accueillis simultanément", 1, 100] }.each do |field, (label, min, max)| %><%= input_field form, field, label, type: :number_field, min: min, max: max, required: true, id: prefix + field.to_s %><% end %>
<%= input_field form, :daily_contribution_points, "Contribution par jour en Points Services", type: :number_field, min: 0, max: 100000, step: 1, required: true, id: prefix + "contribution" %>
<div class="form-field"><%= label_tag prefix + "photos", "Photos (6 maximum, 5 Mo par image)" %><%= file_field_tag "photos[]", id: prefix + "photos", multiple: true, accept: "image/jpeg,image/png,image/webp", class: "control" %></div><%= form.button "Enregistrer le brouillon de mission", class: "btn btn-primary" %><% end %></div>
