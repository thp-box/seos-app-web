<%= render "shared/public_hero", eyebrow: "S’engager ensemble", title: "Voyage solidaire", description: "Participez aux projets d’associations vérifiées, avec des conditions d’accueil transparentes." %>
<section class="container section prose"><%= form_with url: volunteer_missions_path, method: :get do |form| %><%= input_field form, :country, "Filtrer par pays (code à deux lettres)", value: params[:country], maxlength: 2 %><%= form.button "Filtrer les missions", class: "btn btn-outline" %><% end %><% @missions.each do |mission| %><%= render "card", mission: mission %><% end %><% if @missions.empty? %><p>Aucune mission publiée ne correspond pour le moment.</p><% end %></section>
