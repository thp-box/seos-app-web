<article class="travel-card">
  <div class="photo"><% if mission.photos.attached? %><%= image_tag media_path(mission.photos.first), alt: mission.title, loading: "lazy", width: 640, height: 420 %><% else %><div class="travel-photo-placeholder" aria-hidden="true">SEOS</div><% end %></div>
  <div class="body"><span class="ad-category">Association vérifiée · <%= mission.region.presence || mission.public_location %></span>
    <h3><%= link_to mission.title, volunteer_mission_path(mission) %></h3>
    <p><%= truncate(mission.description, length: 150) %></p>
    <strong><%= mission.daily_contribution_points %> PS / jour</strong>
    <p class="travel-inclusions"><%= mission.accommodation %> · <%= mission.meals %></p>
    <small><%= mission.organization.name %></small>
  </div>
</article>
