<section class="container section prose"><h1>Une mission solidaire</h1><%= render "details", mission: @mission %><div class="card"><h2>Proposer ma candidature</h2><% if user_signed_in? %><%= form_with url: account_mission_applications_path do |form| %><%= hidden_field_tag :mission_slug, @mission.slug, id: nil %><%= input_field form, :starts_on, "Mon arrivée souhaitée", type: :date_field, required: true, min: [Date.current, @mission.starts_on].max, max: @mission.ends_on %><%= input_field form, :ends_on, "Mon départ souhaité", type: :date_field, required: true, max: @mission.ends_on %><%= input_field form, :message, "Ma motivation (privée, partagée uniquement avec les responsables de l’association)", type: :text_area, required: true, maxlength: 3000 %><%= form.button "Envoyer ma candidature", class: "btn btn-primary" %><% end %><% else %><%= link_to "Me connecter pour candidater", new_user_session_path, class: "btn btn-primary" %><% end %></div></section>
