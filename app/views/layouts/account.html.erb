<% content_for :workspace do %>
  <div class="container dashboard account-dashboard">
    <aside class="side-menu admin-sidebar account-sidebar" aria-label="Espace personnel">
      <details class="mobile-workspace-navigation"><summary>Navigation de mon compte</summary><%= render "account/shared/navigation", accordion_name: "account-navigation-mobile" %></details>
      <div class="desktop-workspace-navigation"><%= render "account/shared/navigation", accordion_name: "account-navigation-desktop" %></div>
    </aside>
    <main class="workspace account-workspace" id="main-content" tabindex="-1"><%= render "account/shared/notification_context" %><%= yield %></main>
  </div>
<% end %>
<%= render template: "layouts/application" %>
