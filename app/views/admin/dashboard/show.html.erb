<% content_for :title, "Administration" %>
<div class="admin-console">
<header class="admin-console-heading admin-dashboard-hero"><div><span class="account-eyebrow"><%= current_user.super_admin? ? "Super administration" : "Modération et accompagnement" %></span><h1>Votre espace de gestion</h1><p>Retrouvez les outils utiles pour accompagner les membres et intervenir sur les contenus signalés.</p></div><span class="admin-hero-mark" aria-hidden="true"><%= admin_ui_icon("network") %></span></header>
<nav class="admin-section-links" aria-label="Accès rapides aux outils">
<% if current_user.permission?("organizations.manage") %><%= link_to "Associations et missions", admin_network_index_path %><% end %>
<% if current_user.permission?("listings.moderate") %><%= link_to "Voir les annonces", admin_workbench_index_path(kind: "annonces") %><% end %>
<% if current_user.permission?("users.read") %><%= link_to "Voir les membres", admin_users_path %><% end %>
<% if current_user.permission?("reports.manage") %><%= link_to "Voir les signalements", admin_workbench_index_path(kind: "signalements") %><% end %>
</nav>
<%= render "activity", activity: @activity %>
<% if @audit_logs %>
<section id="journal-audit" class="admin-audit-overview">
  <div class="network-section-heading"><div><span class="account-eyebrow">Traçabilité</span><h2>Journal d’audit</h2><p>Les événements administratifs sont conservés sans modification ni suppression.</p></div><span class="network-total"><strong><%= @audit_total %></strong> événements</span></div>
  <%= form_with url: admin_root_path(anchor: "journal-audit"), method: :get, class: "admin-filter-bar" do |form| %><%= hidden_field_tag :period, @activity.days, id: nil %><%= select_field form, :audit_event, "Action", [["Changement de rôle", "user.role_changed"], ["Promotion administrateur", "user.promoted_admin"], ["Ajustement de points", "points.adjustment"], ["Permission attribuée", "permission.granted"], ["Permission révoquée", "permission.revoked"]], include_blank: "Toutes", selected: params[:audit_event] %><%= form.submit "Filtrer le journal", class: "btn btn-deep" %><% end %>
  <div class="card table-scroll" tabindex="0" role="region" aria-label="Événements du journal d’audit"><table><thead><tr><th>Date</th><th>Acteur</th><th>Action</th><th>Cible</th><th>Motif</th></tr></thead><tbody><% @audit_logs.each do |log| %><tr><td><%= l log.created_at, format: :short %></td><td>#<%= log.actor_id %></td><td><%= t("audit_actions.#{log.action}", default: log.action.humanize) %></td><td><%= log.target_type %> #<%= log.target_id %></td><td><%= log.reason %></td></tr><% end %></tbody></table><% if @audit_total.zero? %><p class="empty-state">Aucun événement enregistré.</p><% end %></div>
  <% audit_pages = [(@audit_total / 20.0).ceil, 1].max %><% if audit_pages > 1 %><nav class="pagination" aria-label="Pagination du journal d’audit"><% (1..audit_pages).each do |number| %><%= link_to number, admin_root_path(period: @activity.days, audit_event: params[:audit_event], audit_page: number, anchor: "journal-audit"), aria: ({ current: "page" } if number == @audit_page) %><% end %></nav><% end %>
</section>
<% end %>
<h2>Vos outils de gestion</h2>
<div class="card-grid admin-tools-grid">
<% if current_user.permission?("organizations.manage") %><article class="card"><h2>Associations et missions</h2><p>Examinez les demandes d’association, puis accompagnez la publication des missions.</p><%= link_to "Gérer les demandes", admin_network_index_path, class: "btn btn-deep" %></article><% end %>
<% if current_user.permission?("listings.moderate") %><article class="card"><h2>Modérer les annonces</h2><p>Examinez les annonces en ligne, retrouvez celles qui sont signalées et intervenez avec un motif.</p><%= link_to "Gérer les annonces", admin_workbench_index_path(kind: "annonces"), class: "btn btn-deep" %></article><% end %>
<% if current_user.permission?("users.read") %><article class="card"><h2>Accompagner les membres</h2><p>Consultez le profil public, les annonces, le score de confiance et les avis d’un membre.</p><%= link_to "Consulter les membres", admin_users_path, class: "btn btn-outline" %></article><% end %>
<% if current_user.permission?("reports.manage") %><article class="card"><h2>Traiter les signalements</h2><p>Examinez les abus signalés et consignez votre décision.</p><%= link_to "Ouvrir les signalements", admin_workbench_index_path(kind: "signalements"), class: "btn btn-outline" %></article><% end %>
<% if current_user.super_admin? %>
<article class="card"><h2>Superviser la plateforme</h2><p>Indicateurs d’activité, registres et opérations sensibles réservés aux super administrateurs.</p><%= link_to "Supervision et registres", admin_operations_path, class: "btn btn-deep" %></article>
<article class="card"><h2>Éditeur visuel</h2><p>Modifiez le contenu et l’apparence directement dans l’aperçu du site.</p><%= link_to "Ouvrir l’éditeur visuel", admin_site_index_path, class: "btn btn-outline" %></article>
<article class="card"><h2>Page partenaires</h2><p>Mettez à jour seul le contenu public présentant les partenaires de SEOS.</p><%= link_to "Modifier la page", edit_admin_partnership_page_path, class: "btn btn-outline" %></article>
<% end %>
</div>
<% if admin_navigation_groups.empty? %><p class="notice">Aucun outil ne vous a encore été attribué. Un super administrateur peut vous donner les accès nécessaires.</p><% else %><p>Le menu présente les rubriques correspondant à vos permissions.</p><% end %>
</div>
