<% content_for :title, "Confiance et recours" %>
<%= render "admin/shared/heading", title: "Confiance et recours" %>
<p>Corrigez une source documentée, jamais directement une note. Les signaux techniques sont instruits séparément.</p>
<section class="card"><h2>Parrainage</h2><p>Tout membre dont le compte est actif et l’e-mail confirmé dispose de son lien permanent. Aucune condition d’ancienneté n’est appliquée.</p></section>
<% if @appeals %><h2>Recours humains</h2><% @appeals.each do |appeal| %><article class="card"><h3>Recours n° <%= appeal.id %> · membre n° <%= appeal.user_id %> · <%= human_value appeal.status %></h3><p><%= appeal.statement %></p><p>Échéance : <%= l appeal.response_due_at, format: :short %></p><p><%= appeal.decision %></p><% if %w[open investigating].include?(appeal.status) %><%= render "decision", operation: "appeal", record: appeal, choices: [["Prendre en charge", "investigating"], ["Accepter après correction de la source", "accepted"], ["Maintenir le calcul", "rejected"]] %><% end %></article><% end %><% end %>
<h2>Preuves récentes</h2>
<details class="card"><summary>Calculs conservés (30 derniers)</summary><% @snapshots.each do |snapshot| %><p>Membre n° <%= snapshot.user_id %> · calcul n° <%= snapshot.id %> · <%= snapshot.result["score"] || "sans note" %> · version <%= snapshot.result["version"] %> · <%= l snapshot.calculated_at, format: :short %> · <%= snapshot.result["confidence_label"] %></p><% end %></details>
<% @events.each do |event| %><details class="card"><summary>Preuve n° <%= event.id %> · membre n° <%= event.subject_id %> · <%= event.dimension %></summary><p>Échange n° <%= event.service_request_id %> · observation normalisée <%= event.normalized_value %> · <%= event.event_kind %></p><% if current_user.permission?("trust.manage") %><%= render "decision", operation: "correct", record: event, choices: [["Exclure la preuve erronée", "exclude"], ["Restaurer la preuve", "restore"]] %><% end %></details><% end %>
<h2>Parrainages récents</h2>
<% @referrals.each do |referral| %><details class="card"><summary>Soutien n° <%= referral.id %> · <%= human_value referral.status %></summary><p>Parrain n° <%= referral.referrer_id %> · filleul n° <%= referral.referred_user_id %></p><% if current_user.permission?("trust.manage") %><p><%= %w[objected invalidated].include?(referral.status) ? "Rétablir ce soutien après revue" : "Invalider ce soutien après revue" %></p><%= render "decision", operation: %w[objected invalidated].include?(referral.status) ? "restore_referral" : "referral", record: referral, choices: nil %><% end %></details><% end %>
