<% if current_user.super_admin? %><div class="card"><h2>Activation des parcours publics</h2><%= form_with url: admin_network_index_path do |form| %><%= hidden_field_tag :operation, "flag", id: nil %><%= select_field form, :key, "Parcours", [["Voyage solidaire", "voyage_enabled"], ["Partenariats", "partnerships_enabled"]] %><%= select_field form, :enabled, "État", [["Actif", "1"], ["Désactivé", "0"]] %><%= input_field form, :reason, "Motif du changement global", required: true %><%= form.button "Enregistrer l’état", class: "btn btn-outline" %><% end %></div><% end %>
