<% if current_user.super_admin? %><div class="card admin-form-panel"><h2>Visibilité du Voyage solidaire</h2><%= form_with url: admin_network_index_path do |form| %><%= hidden_field_tag :operation, "flag", id: nil %><%= hidden_field_tag :key, "voyage_enabled", id: nil %><%= select_field form, :enabled, "État du parcours", [["Actif", "1"], ["Désactivé", "0"]] %><%= input_field form, :reason, "Motif du changement", required: true %><%= form.button "Enregistrer l’état", class: "btn btn-outline" %><% end %></div><% end %>
