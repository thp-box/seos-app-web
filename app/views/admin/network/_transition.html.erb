<%= form_with url: url, method: method do |form| %><%= hidden_field_tag :operation, operation, id: nil %><%= hidden_field_tag :record_id, record.id, id: nil %><% prefix = "#{operation}-#{record.id}-" %><div class="form-field"><%= form.label :status, "Décision", for: prefix + "status" %><%= form.select :status, network_choices(statuses), {}, id: prefix + "status", class: "control" %></div><%= input_field form, :reason, "Motif de décision", required: true, maxlength: 500, id: prefix + "reason" %><%= form.button "Enregistrer la décision", class: "btn btn-outline" %><% end %>
