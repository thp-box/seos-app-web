<div class="community-page"><h1>Organisations, missions et partenaires</h1><p>Chaque publication et décision est auditée. Les données légales nécessitent une permission et une révélation motivée.</p>
<% if @revealed %><div class="card"><h2>Identité légale de <%= @revealed.name %></h2><p><%= @revealed.legal_name %></p><p><%= @revealed.registration_number %></p><p><%= @revealed.legal_email %></p></div><% end %>
<% @organizations.each do |organization| %><article class="card"><h2><%= organization.name %></h2><p><%= network_label(organization.status) %> · <%= network_label(organization.kind) %></p><p><%= organization.description %></p><p>Propriétaires : <%= organization.organization_memberships.active.where(role: "owner").pluck(:user_id).join(", ") %></p>
<% if current_user.permission?("organizations.legal") %><%= form_with url: admin_network_index_path, data: { turbo: false } do |form| %><%= hidden_field_tag :operation, "reveal", id: nil %><%= hidden_field_tag :record_id, organization.id, id: nil %><%= input_field form, :reason, "Motif de consultation des données légales", required: true, id: "reveal-#{organization.id}" %><%= form.button "Consulter l’identité légale", class: "btn btn-outline" %><% end %><% end %>
<% if current_user.permission?("organizations.manage") %><%= render "transition", url: admin_network_index_path, method: :post, record: organization, operation: "review", statuses: %w[verified rejected suspended pending] %><% end %>
<% if current_user.super_admin? %><details><summary>Actions exceptionnelles</summary><%= form_with url: admin_network_index_path do |form| %><%= hidden_field_tag :operation, "recover_owner", id: nil %><%= hidden_field_tag :record_id, organization.id, id: nil %><%= input_field form, :user_id, "Compte à nommer propriétaire", type: :number_field, min: 1, required: true, id: "recover-user-#{organization.id}" %><%= input_field form, :reason, "Motif de récupération de l’organisation", required: true, id: "recover-reason-#{organization.id}" %><%= form.button "Rétablir un propriétaire", class: "btn btn-outline" %><% end %><%= form_with url: admin_network_index_path do |form| %><%= hidden_field_tag :operation, "review", id: nil %><%= hidden_field_tag :record_id, organization.id, id: nil %><%= hidden_field_tag :status, organization.status, id: nil %><div class="form-field"><%= form.label :kind, "Type d’organisation", for: "kind-#{organization.id}" %><%= form.select :kind, network_choices(Organization.kinds.keys), { selected: organization.kind }, id: "kind-#{organization.id}", class: "control" %></div><%= input_field form, :reason, "Motif de changement de type", id: "kind-reason-#{organization.id}", required: true %><%= form.button "Changer le type", class: "btn btn-outline" %><% end %></details><% end %>
<% if current_user.super_admin? && organization.association? && organization.verified? %><details><summary>Créer une annonce monde pour cette association</summary><%= render "volunteer_missions/form", mission: organization.volunteer_missions.new, url: admin_network_index_path, method: :post, admin: true %></details><% end %>
<% if current_user.permission?("partnerships.manage") %><details><summary>Créer un partenariat</summary><%= render "partnerships/form", record: organization.partnerships.new, url: admin_network_index_path, method: :post, admin: true %></details><% end %></article><% end %>
<% if @missions %><h2>Missions à suivre</h2><% @missions.each do |mission| %><article class="card"><%= render "volunteer_missions/details", mission: mission %><p><%= network_label(mission.status) %></p><%= render "transition", url: admin_network_index_path, method: :post, record: mission, operation: "mission_transition", statuses: current_user.super_admin? ? %w[published paused archived] : %w[paused archived] %><% if current_user.super_admin? %><details><summary>Modifier le brouillon</summary><%= render "volunteer_missions/form", mission: mission, url: admin_network_index_path, method: :post, admin: true %></details><% end %></article><% end %><% end %>
<% if @partnerships %><h2>Partenariats à suivre</h2><% @partnerships.each do |record| %><article class="card"><%= render "partnerships/details", record: record %><p><%= network_label(record.status) %></p><%= render "transition", url: admin_network_index_path, method: :post, record: record, operation: "partnership_transition", statuses: %w[published archived] %><details><summary>Modifier le brouillon, l’ordre ou les dates</summary><%= render "partnerships/form", record: record, url: admin_network_index_path, method: :post, admin: true %></details></article><% end %><% end %>
<% if current_user.super_admin? %><div class="card"><h2>Activation des parcours publics</h2><%= form_with url: admin_network_index_path do |form| %><%= hidden_field_tag :operation, "flag", id: nil %><%= select_field form, :key, "Parcours", [["Voyage solidaire", "voyage_enabled"], ["Partenariats", "partnerships_enabled"]] %><%= select_field form, :enabled, "État", [["Actif", "1"], ["Désactivé", "0"]] %><%= input_field form, :reason, "Motif du changement global", required: true %><%= form.button "Enregistrer l’état", class: "btn btn-outline" %><% end %></div><% end %></div>
