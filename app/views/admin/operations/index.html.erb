<% content_for :title, "Pilotage" %><h1>Pilotage et registres</h1><p>Lecture bornée à 100 lignes, sans contenu privé. Les registres probatoires et financiers restent immuables.</p>
<%= form_with url: admin_operations_path, method: :get do |f| %><label for="resource">Ressource</label><%= f.select :resource, @resources.keys, { selected: @kind }, class: "control" %><%= input_field f, :q, "Identifiant", value: params[:q] %><%= f.button "Rechercher", class: "btn btn-deep" %><% end %>
<p><%= @count %> résultats</p><ul><% @records.each do |row| %><li>#<%= row.id %> · <%= row.attributes["status"] %> · <%= l row.created_at.to_date %><% if row.is_a?(User) %> · <%= link_to "Fiche membre", user_admin_operation_path(row) %><% end %></li><% end %></ul>
<%= form_with url: admin_operations_path, method: :get do |f| %><%= hidden_field_tag :resource, @kind %><%= hidden_field_tag :q, params[:q] %><%= hidden_field_tag :format, "csv" %><%= input_field f, :reason, "Motif de l’export", id: "export-reason" %><%= f.button "Exporter au maximum 100 lignes", class: "btn btn-outline" %><% end %>
<% if current_user.permission?("operations.manage") %><h2>Suspension groupée</h2><%= form_with url: admin_operations_path do |f| %><%= hidden_field_tag :operation, "preview" %><%= input_field f, :ids, "Identifiants des membres (20 maximum)" %><%= input_field f, :reason, "Motif", id: "bulk-reason" %><%= f.button "Prévisualiser la sélection", class: "btn btn-outline" %><% end %>
<% @operations.each do |operation| %><article class="card"><h3>Opération #<%= operation.id %></h3><p>Membres : <%= operation.targets.keys.join(", ") %> · <%= operation.reason %></p><% if !operation.executed_at && current_user.super_admin? && operation.actor_id != current_user.id %><%= button_to "Confirmer la suspension de cette sélection", admin_operations_path, params: { operation: "execute", record_id: operation.id }, class: "btn btn-deep" %><% end %></article><% end %><% end %>
<% if current_user.super_admin? %><h2>Blocage temporaire d’une adresse</h2><%= form_with url: admin_operations_path do |f| %><%= hidden_field_tag :operation, "block" %><%= input_field f, :email, "Adresse", type: :email_field %><%= input_field f, :expires_at, "Expiration (moins d’un an)", type: :datetime_local_field %><%= input_field f, :reason, "Motif", id: "block-reason" %><%= f.button "Bloquer cette adresse", class: "btn btn-outline" %><% end %><% end %>
<% if current_user.super_admin? %><h2>Indexation et robots</h2><%= form_with url: admin_operations_path do |f| %><%= hidden_field_tag :operation, "crawlers", id: nil %><div class="form-field"><%= f.check_box :search_enabled, checked: CrawlerPolicy.current&.search_enabled != false %><%= f.label :search_enabled, "Autoriser les robots de recherche sur les pages publiques" %></div><div class="form-field"><%= f.check_box :training_enabled, checked: CrawlerPolicy.current&.training_enabled == true %><%= f.label :training_enabled, "Autoriser les robots d’entraînement connus sur les pages publiques" %></div><%= input_field f, :reason, "Motif", id: "crawler-reason" %><%= f.button "Publier les consignes aux robots", class: "btn btn-outline" %><% end %><% end %>
