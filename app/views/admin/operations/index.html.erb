<div class="admin-console" data-controller="workspace-tabs" data-workspace-tabs-default-value="<%= params[:resource].present? ? 'registers' : 'overview' %>">
<% content_for :title, "Supervision et registres" %>
<header class="admin-console-heading"><div><span class="account-eyebrow">Super administration</span><h1>Supervision et registres</h1><p>Suivez l’activité du site, retrouvez une référence et préparez les interventions sensibles. Les registres conservent l’historique ; ils ne servent pas à modifier directement les données.</p></div></header>
<nav class="workspace-tabs" aria-label="Rubriques de supervision" data-workspace-tabs-target="navigation">
<% [["overview", "Vue d’ensemble"], ["registers", "Explorer les registres"], ["actions", "Opérations sensibles"]].each do |key, label| %><button type="button" id="workspace-tab-<%= key %>" data-workspace-tabs-target="tab" data-key="<%= key %>" data-action="workspace-tabs#select keydown->workspace-tabs#keyboard"><%= label %></button><% end %>
</nav>
<section id="workspace-overview" data-workspace-tabs-target="panel" data-key="overview">
<div class="admin-summary-grid">
<% [["Membres", @metrics[:members], admin_users_path], ["Annonces publiées", @metrics[:listings], admin_workbench_index_path(kind: "annonces", status: "published")], ["Signalements ouverts", @metrics[:reports], admin_workbench_index_path(kind: "signalements")], ["Organisations en attente", @metrics[:organizations], admin_network_index_path]].each do |label, count, path| %>
<article class="card"><strong><%= count %></strong><span><%= label %></span><%= link_to "Consulter →", path, aria: { label: "Consulter : #{label}" } %></article>
<% end %>
</div>
<section class="card"><h2>À quoi servent les registres ?</h2><p>Ils permettent de retrouver une opération par son identifiant, d’en vérifier le statut et la date, puis d’exporter une sélection pour un contrôle. Les messages, coordonnées, justificatifs et autres contenus privés ne figurent pas dans ces listes ni dans les exports.</p><p>La modération quotidienne se fait dans les fiches membres, annonces et signalements. Les suspensions groupées, les blocages d’accès et les consignes aux robots sont réunis dans « Opérations sensibles ».</p><%= link_to "Ouvrir le journal d’audit", admin_audit_logs_path, class: "btn btn-outline" %></section>
</section>
<section id="workspace-registers" data-workspace-tabs-target="panel" data-key="registers">
<h2>Explorer les registres</h2>
<%= form_with url: admin_operations_path, method: :get, class: "admin-filter-bar" do |f| %>
<%= hidden_field_tag :tab, "registers" %>
<%= select_field f, :resource, "Registre", @resources.map { |key, (model, _)| [supervision_register_label(key, model), key] }.sort_by(&:first), selected: @kind %>
<%= input_field f, :q, "Identifiant exact", value: params[:q] %><%= f.button "Rechercher", class: "btn btn-deep" %><% end %>
<p><%= @count %> résultats · 20 par page · <%= supervision_register_label(@kind, @model) %></p>
<div class="card table-scroll" tabindex="0" role="region" aria-label="Résultats du registre"><table><thead><tr><th>Référence</th><th>Statut</th><th>Création</th></tr></thead><tbody>
<% @records.each do |row| %><tr><td><% if row.is_a?(User) %><%= link_to "Membre ##{row.id}", admin_user_path(row) %><% else %>#<%= row.id %><% end %></td><td><%= row.attributes["status"].present? ? human_value(row.attributes["status"]) : "—" %></td><td><%= l row.created_at, format: :short %></td></tr><% end %>
</tbody></table><% if @records.empty? %><p>Aucune référence trouvée.</p><% end %></div>
<%= render "shared/pagination", page: @page, total: @count %>
<details class="card"><summary>Exporter cette sélection</summary><p>L’export contient au maximum les 100 premières références correspondant aux filtres, avec statut et date. Le motif est journalisé.</p>
<%= form_with url: admin_operations_path, method: :get do |f| %><%= hidden_field_tag :resource, @kind, id: nil %><%= hidden_field_tag :q, params[:q], id: nil %><%= hidden_field_tag :format, "csv", id: nil %><%= input_field f, :reason, "Motif de l’export", id: "export-reason", required: true, maxlength: 500 %><%= f.button "Exporter au maximum 100 lignes", class: "btn btn-outline" %><% end %>
</details></section>
<section id="workspace-actions" data-workspace-tabs-target="panel" data-key="actions">
<% if current_user.permission?("operations.manage") %><h2>Suspension groupée</h2><p>Préparez une sélection de 20 membres maximum. Un autre super administrateur doit confirmer dans les 15 minutes ; toute modification des comptes impose une nouvelle vérification.</p><%= form_with url: admin_operations_path do |f| %><%= hidden_field_tag :operation, "preview" %><%= input_field f, :ids, "Identifiants des membres (20 maximum)" %><%= input_field f, :reason, "Motif", id: "bulk-reason" %><%= f.button "Prévisualiser la sélection", class: "btn btn-outline" %><% end %>
<% @operations.each do |operation| %><article class="card"><h3>Opération #<%= operation.id %></h3><p>Membres : <%= operation.targets.keys.join(", ") %> · <%= operation.reason %></p><p><strong><%= operation.executed_at ? "Exécutée" : (operation.expires_at <= Time.current ? "Prévisualisation expirée" : "En attente d’une seconde validation") %></strong> · Préparée par le membre #<%= operation.actor_id %> · Échéance : <%= l operation.expires_at, format: :short %></p><% if !operation.executed_at && operation.expires_at > Time.current && current_user.super_admin? && operation.actor_id != current_user.id %><%= button_to "Confirmer la suspension de cette sélection", admin_operations_path, params: { operation: "execute", record_id: operation.id }, class: "btn btn-deep" %><% end %></article><% end %><% end %>
<% if current_user.super_admin? %><h2>Blocage temporaire d’une adresse</h2><%= form_with url: admin_operations_path do |f| %><%= hidden_field_tag :operation, "block" %><%= input_field f, :email, "Adresse", type: :email_field %><%= input_field f, :expires_at, "Expiration (moins d’un an)", type: :datetime_local_field %><%= input_field f, :reason, "Motif", id: "block-reason" %><%= f.button "Bloquer cette adresse", class: "btn btn-outline" %><% end %><% end %>
<% if current_user.super_admin? %><h2>Indexation et robots</h2><%= form_with url: admin_operations_path do |f| %><%= hidden_field_tag :operation, "crawlers", id: nil %><div class="form-field"><%= f.check_box :search_enabled, checked: CrawlerPolicy.current&.search_enabled != false %><%= f.label :search_enabled, "Autoriser les robots de recherche sur les pages publiques" %></div><div class="form-field"><%= f.check_box :training_enabled, checked: CrawlerPolicy.current&.training_enabled == true %><%= f.label :training_enabled, "Autoriser les robots d’entraînement connus sur les pages publiques" %></div><%= input_field f, :reason, "Motif", id: "crawler-reason" %><%= f.button "Publier les consignes aux robots", class: "btn btn-outline" %><% end %><% end %>
</section></div>
