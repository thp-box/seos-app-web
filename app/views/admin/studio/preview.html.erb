<section class="container section"><h1>Prévisualisation : <%= @studio_version.name %></h1><p>Largeur de référence : <%= @preview_width %> px. Cette proposition n’est pas publique.</p><%= form_with url: preview_admin_studio_path(@studio_version), method: :get do |f| %><%= hidden_field_tag :width, @preview_width %><%= select_field f, :page, "Page à prévisualiser", StudioVersion::PAGES.map { |p| [human_value(p), p] }, selected: @preview_page %><%= f.button "Afficher cette page", class: "btn btn-outline" %><% end %><iframe class="studio-frame studio-preview-<%= @preview_width %>" src="<%= preview_admin_studio_path(@studio_version, canvas: "1", page: @preview_page) %>" title="Aperçu de la page sélectionnée" width="<%= @preview_width %>" height="850"></iframe></section>
