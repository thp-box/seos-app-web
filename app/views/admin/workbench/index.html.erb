<h1>Gestion · <%= @kind.humanize %></h1><% if %w[categories restrictions contenus].include?(@kind) %><p><%= link_to "Créer", new_admin_workbench_path(kind: @kind), class: "btn btn-primary" %></p><% end %><% if @records.empty? %><p>Aucun enregistrement.</p><% end %><div class="table-scroll"><table><thead><tr><th>Référence</th><th>Libellé public</th><th>Ouvrir</th></tr></thead><tbody><% @records.each do |record| %><tr><td><%= record.id %></td><td><%= case record; when Category then record.name; when Listing, ContentVersion then record.title; when Profile then record.display_name; when CategoryRestriction then record.reason; when Report then "Signalement — #{record.status}"; when ServiceRequest then "Échange — #{human_value(record.status)}"; when ContactRequest then "Contact équipe — #{record.status}"; end %></td><td><%= link_to "Consulter", admin_workbench_path(record.id, kind: @kind) %></td></tr><% end %></tbody></table></div>
