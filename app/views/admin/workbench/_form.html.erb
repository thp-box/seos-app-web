<%= form_with scope: :record, url: @record.persisted? ? admin_workbench_path(@record.id, kind: @kind) : admin_workbench_index_path(kind: @kind), method: @record.persisted? ? :patch : :post, class: "card" do |f| %>
<% case @record; when Category %><header class="admin-form-intro"><span class="eyebrow">Catalogue des annonces</span><h2><%= @record.persisted? ? "Modifier la catégorie" : "Ajouter une catégorie" %></h2><p>Une sous-catégorie est simplement rattachée à une catégorie principale. Laissez le rattachement vide pour créer une catégorie principale.</p></header><div class="form-grid"><%= input_field f, :name, "Nom public", value: @record.name, required: true, placeholder: "Exemple : Jardinage" %><%= input_field f, :slug, "Identifiant URL", value: @record.slug, required: true, placeholder: "Exemple : jardinage" %></div><%= select_field f, :parent_id, "Catégorie principale (facultatif)", Category.kept.where.not(id: @record.id).order(:position, :name).map { |c| [c.lineage.reverse.map(&:name).join(" › "),c.id] }, include_blank: "Aucune — catégorie principale", selected: @record.parent_id %><div class="form-grid"><%= input_field f, :position, "Ordre d’affichage", type: :number_field, value: @record.position, min: 0 %><fieldset class="admin-choice-group"><legend>Disponibilité</legend><label><%= f.check_box :active, checked: @record.active %><span>Catégorie active</span></label><label><%= f.check_box :sensitive, checked: @record.sensitive %><span>Publication soumise à une revue</span></label></fieldset></div>
<% when ContentVersion %><%= select_field f, :kind, "Type", [["Page explicative", "page"],["Article", "article"],["Document légal", "legal"]], selected: @record.kind %><%= input_field f, :slug, "Identifiant URL", value: @record.slug, required: true %><p>Pages : <%= ContentVersion::PAGE_SLUGS.join(", ") %>. Documents légaux : <%= ContentVersion::LEGAL_SLUGS.join(", ") %>.</p><%= input_field f, :title, "Titre", value: @record.title, required: true %><%= input_field f, :summary, "Résumé", value: @record.summary %><%= input_field f, :body, "Texte (sans HTML)", type: :text_area, value: @record.body, rows: 12, required: true %><fieldset><legend>Séparateurs décoratifs</legend><% ContentVersion::PRESETS.each do |preset| %><label><%= check_box_tag "record[decorations][]", preset, @record.decorations.include?(preset), id: "decoration_#{preset}" %> <%= preset.humanize %></label><% end %></fieldset>
<% end %><div class="form-field"><%= label_tag :reason, "Motif de cette modification" %><%= text_field_tag :reason, nil, required: true, maxlength: 500, class: "control" %></div><%= f.submit "Enregistrer", class: "btn btn-deep" %><% end %>
