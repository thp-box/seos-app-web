<%= form_with scope: :record, url: @record.persisted? ? admin_workbench_path(@record.id, kind: @kind) : admin_workbench_index_path(kind: @kind), method: @record.persisted? ? :patch : :post, class: "card" do |f| %>
<% case @record; when Category %><%= input_field f, :name, "Nom", value: @record.name, required: true %><%= input_field f, :slug, "Identifiant URL", value: @record.slug, required: true %><%= select_field f, :parent_id, "Catégorie parente", Category.where.not(id: @record.id).map { |c| [c.name,c.id] }, include_blank: "Aucune", selected: @record.parent_id %><%= input_field f, :position, "Ordre", type: :number_field, value: @record.position %><label><%= f.check_box :active, checked: @record.active %> Catégorie active</label><label><%= f.check_box :sensitive, checked: @record.sensitive %> Catégorie sensible (revue nécessaire)</label>
<% when CategoryRestriction %><%= select_field f, :category_id, "Catégorie restreinte", Category.all.map { |c| [c.name,c.id] }, include_blank: "Toutes", selected: @record.category_id %><%= input_field f, :term, "Terme à bloquer (texte simple)", value: @record.term %><%= input_field f, :reason, "Motif de restriction", value: @record.reason, required: true %><%= input_field f, :starts_at, "Début", type: :datetime_local_field, value: @record.starts_at&.strftime("%Y-%m-%dT%H:%M"), required: true %><%= input_field f, :ends_at, "Fin facultative", type: :datetime_local_field, value: @record.ends_at&.strftime("%Y-%m-%dT%H:%M") %><%= select_field f, :existing_action, "Action sur les annonces existantes", [["Mise en revue", "review"],["Mise en pause", "pause"]], selected: @record.existing_action %><label><%= f.check_box :active, checked: @record.active %> Restriction active</label><%= f.hidden_field :lock_version, value: @record.lock_version %>
<% when ContentVersion %><%= select_field f, :kind, "Type", [["Page explicative", "page"],["Article", "article"],["Document légal", "legal"]], selected: @record.kind %><%= input_field f, :slug, "Identifiant URL", value: @record.slug, required: true %><p>Pages : <%= ContentVersion::PAGE_SLUGS.join(", ") %>. Documents légaux : <%= ContentVersion::LEGAL_SLUGS.join(", ") %>.</p><%= input_field f, :title, "Titre", value: @record.title, required: true %><%= input_field f, :summary, "Résumé", value: @record.summary %><%= input_field f, :body, "Texte (sans HTML)", type: :text_area, value: @record.body, rows: 12, required: true %><fieldset><legend>Séparateurs décoratifs</legend><% ContentVersion::PRESETS.each do |preset| %><label><%= check_box_tag "record[decorations][]", preset, @record.decorations.include?(preset), id: "decoration_#{preset}" %> <%= preset.humanize %></label><% end %></fieldset>
<% end %><div class="form-field"><%= label_tag :reason, "Motif de cette modification" %><%= text_field_tag :reason, nil, required: true, maxlength: 500, class: "control" %></div><%= f.submit "Enregistrer", class: "btn btn-deep" %><% end %>
