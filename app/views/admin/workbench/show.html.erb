<%= link_to "Retour à la liste", admin_workbench_index_path(kind: @kind) %><h1><%= @kind.humanize %> · <%= @record.id %></h1>
<% case @record; when Category, CategoryRestriction %><%= render "form" %>
<% when Listing, Profile %><h2><%= @record.is_a?(Listing) ? @record.title : @record.display_name %></h2><%= plain_paragraphs(@record.is_a?(Listing) ? @record.description : @record.bio) %><p>Statut : <%= human_value @record.status %></p><%= form_with url: admin_workbench_path(@record.id, kind: @kind), method: :patch do |f| %><%= select_field f, :status, "Nouveau statut", choices_for(@record.is_a?(Listing) ? %w[pending_review paused removed published] : %w[restricted published]) %><%= input_field f, :reason, "Motif", required: true %><%= f.submit "Modérer", class: "btn btn-deep" %><% end %>
<% when ServiceRequest %><p>Échange <%= @record.id %> · <%= human_value @record.status %></p><p>Les messages, lieux et coordonnées sont masqués. Une révélation nécessite un signalement ouvert portant sur cet échange.</p>
<% when ContactRequest %><p>Demande adressée à l’équipe · <%= @record.status %>. Le contenu et l’e-mail sont masqués.</p><%= form_with url: admin_workbench_path(@record.id, kind: @kind), method: :patch do |f| %><%= input_field f, :reason, "Motif de clôture", required: true %><%= f.submit "Clôturer la demande", class: "btn btn-deep" %><% end %>
<% when Report %><p>Motif : <%= @record.reason %></p><p><%= @record.details %></p><p>Cible : <%= @record.reportable_type %> #<%= @record.reportable_id %></p><p>Échéance : <%= l @record.due_at, format: :short %></p><p>Décision : <%= @record.resolution %></p><%= form_with url: admin_workbench_path(@record.id, kind: @kind), method: :patch do |f| %><%= select_field f, :decision, "Action", [["M’assigner le dossier", "assign"],["Masquer la cible", "hide"],["Restaurer / remettre en revue", "restore"],["Invalider un avis avec motif", "invalidate_review"],["Clôturer après revue", "resolve"]] %><%= input_field f, :reason, "Motif de décision", type: :text_area, required: true %><%= f.submit "Appliquer et notifier", class: "btn btn-deep" %><% end %>
<% when ContentVersion %><span class="badge">Version <%= @record.version %> · <%= @record.published_at ? "Publication : #{l(@record.published_at, format: :short)}" : "Brouillon privé" %></span><h2><%= @record.title %></h2><p><%= @record.summary %></p><%= plain_paragraphs @record.body %><% @record.decorations.each do |preset| %><div class="section-decoration <%= preset %>" aria-hidden="true"></div><% end %><p><%= link_to "Créer une nouvelle version à partir de celle-ci", new_admin_workbench_path(kind: @kind, from: @record.id) %></p><% if !@record.published_at && current_user.super_admin? %><%= form_with url: admin_workbench_path(@record.id, kind: @kind), method: :patch do |f| %><%= input_field f, :published_at, "Date de publication (vide = maintenant)", type: :datetime_local_field %><%= input_field f, :reason, "Motif de publication", required: true %><%= f.submit "Publier cette version", class: "btn btn-primary" %><% end %><% end %>
<% end %>
<% if @record.is_a?(ServiceRequest) || @record.is_a?(ContactRequest) || (@record.is_a?(Profile) && current_user.super_admin?) %><section class="card"><h2>Accès sensible audité</h2><% if @revealed %><% case @record; when ServiceRequest %><% @record.messages.each do |message| %><p><%= message.body %></p><% end %><% when Profile %><p>Téléphone : <%= @record.phone %></p><p>Adresse : <%= @record.address_line %></p><% when ContactRequest %><p>E-mail : <%= @record.email %></p><%= plain_paragraphs @record.message %><% end %><% else %><%= form_with url: reveal_admin_workbench_path(@record.id, kind: @kind), method: :post do |f| %><% if @record.is_a?(ServiceRequest) %><%= input_field f, :report_id, "Numéro du signalement ouvert", type: :number_field, required: true %><% end %><%= input_field f, :reason, "Justification de l’accès", required: true %><%= f.submit "Révéler et journaliser", class: "btn btn-outline" %><% end %><% end %></section><% end %>
