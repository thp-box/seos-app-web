
  <p><%= @area == "header" ? "Le haut du site contient votre logo, le menu et les accès au compte. Les changements apparaîtront sur toutes les pages." : "Le bas du site présente vos informations et vos liens utiles. Les changements apparaîtront sur toutes les pages." %></p><% chrome = @version.chrome(@area) %>
  <%= form_with url: admin_site_path(@version), method: :patch do |f| %><%= hidden_field_tag :operation, "chrome", id: nil %><%= hidden_field_tag :area, @area, id: nil %>
    <% chrome.except("links").each do |key, value| %><div class="form-field"><%= label_tag "chrome-#{key}", { "mobile_join_label" => "Inscription dans le menu mobile", "join_label" => "Bouton d’inscription", "login_label" => "Lien de connexion", "account_label" => "Menu du compte", "logo" => "Logo", "alt" => "Description du logo", "title" => "Texte principal", "description" => "Informations complémentaires" }.fetch(key) %><% if key == "logo" %><%= select_tag "chrome[#{key}]", options_for_select(site_image_options(@assets), value), id: "chrome-#{key}", class: "control" %><% else %><%= text_area_tag "chrome[#{key}]", value, id: "chrome-#{key}", class: "control", required: key == "alt" %><% end %></div><% end %>
    <h3>Liens dans l’ordre d’affichage</h3><p>Remplissez la dernière ligne pour ajouter un lien, puis enregistrez. Videz les deux champs d’une ligne pour la retirer.</p>
    <% [chrome["links"].size + 1, 12].min.times do |i| %><% link = chrome["links"][i] || {} %><div class="site-link-row"><div class="form-field"><%= label_tag "link-label-#{i}", "Lien #{i + 1} — Nom affiché" %><%= text_field_tag "links[#{i}][label]", link["label"], id: "link-label-#{i}", class: "control" %></div><div class="form-field"><%= label_tag "link-url-#{i}", "Lien #{i + 1} — Adresse à ouvrir" %><%= text_field_tag "links[#{i}][url]", link["url"], id: "link-url-#{i}", class: "control" %></div></div><% end %><%= f.button "Enregistrer les modifications", class: "btn btn-deep" %>
  <% end %>
