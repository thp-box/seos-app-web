
  <h2>Bibliothèque d’images</h2><%= form_with url: admin_studio_index_path, multipart: true do |f| %><%= hidden_field_tag :return_site_id, @version.id %><%= hidden_field_tag :return_site_area, @area %><%= hidden_field_tag :operation, "upload", id: nil %><%= input_field f, :image, "Image JPEG, PNG ou WebP (5 Mo maximum)", type: :file_field, accept: "image/jpeg,image/png,image/webp", required: true %><%= f.button "Ajouter une image", class: "btn btn-deep" %><% end %>
  <div class="card-grid"><% @assets.each do |asset| %><figure class="card"><%= image_tag media_path(asset.image.attachment), alt: "Image importée #{asset.id}", class: "site-thumbnail" %><figcaption>Image #<%= asset.id %></figcaption></figure><% end %></div>
