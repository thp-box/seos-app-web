<% if @page["blocks"].empty? %>
  <div class="card"><h2>Préparer le contenu de cette page</h2><p><%= @slug == "home" ? "L’accueil actuel restera visible pendant votre travail. Pour préparer sa nouvelle présentation, commencez par choisir une introduction ou un texte ci-dessous." : "Cette page n’a pas encore de contenu. Commencez par ajouter un texte ou une présentation ci-dessous." %></p></div>
<% else %>
  <h2>Les parties de votre page</h2><p>Elles apparaissent dans cet ordre sur le site. Choisissez « Modifier le contenu » pour changer les textes ou les images d’une partie.</p>
  <% @page["blocks"].each_with_index do |block, index| %><article class="card site-block editor-section-card"><div><span class="badge">Partie <%= index + 1 %><%= " · Masquée" if block["hidden"] %></span><h3><%= site_section_name(block["template"]) %></h3><p><%= site_section_description(block["template"]) %></p></div>
    <%= link_to "Modifier le contenu", edit_admin_site_path(@version, page: @slug, section: block["id"]), class: "btn btn-deep" %>
    <details class="editor-advanced"><summary>Déplacer, dupliquer ou retirer cette partie</summary><div class="actions"><% { "up" => "Monter", "down" => "Descendre", "duplicate" => "Dupliquer", "remove" => "Retirer de la page" }.each do |action, label| %><%= button_to label, admin_site_path(@version), method: :patch, params: { operation: "page", page: @slug, block_id: block["id"], block_action: action }, class: "btn btn-outline", disabled: (action == "up" && index.zero?) || (action == "down" && index == @page["blocks"].size - 1) %><% end %></div><p>Vous pourrez retrouver les contenus retirés dans vos anciennes sauvegardes.</p></details>
  </article><% end %>
  <details class="card editor-advanced"><summary>Changer le nom de la page</summary><%= form_with url: admin_site_path(@version), method: :patch do |f| %><%= hidden_field_tag :operation, "page", id: nil %><%= hidden_field_tag :page, @slug, id: nil %><%= input_field f, :title, "Nom de la page", value: @page["title"], required: true %><p>Ce nom sert à reconnaître la page. Les titres visibles dans son contenu se modifient dans les parties ci-dessus.</p><%= f.button "Enregistrer le nom", class: "btn btn-deep" %><% end %></details>
<% end %>
<details class="card editor-add-section" <%= "open" if @page["blocks"].empty? %>><summary>Ajouter une partie à la page</summary><p>Une partie regroupe un contenu précis : un texte, une grande présentation avec photo ou des annonces récentes.</p><div class="card-grid"><% SiteDesign.templates.each_key do |key| %><article class="editor-template"><h3><%= site_section_name(key) %></h3><p><%= site_section_description(key) %></p><%= button_to "Ajouter cette partie", admin_site_path(@version), method: :patch, params: { operation: "page", page: @slug, template: key }, class: "btn btn-outline" %></article><% end %></div></details>
