<h1>Soutien financier</h1><p>Parcours <strong><%= FeatureFlag.support_enabled? ? "activé" : "désactivé" %></strong>. Aucun effet sur les Points Services, niveaux, Trust Score ou mises en avant.</p>
<% if current_user.super_admin? %><div class="card"><h2>Activation après validation</h2><%= form_with url: admin_financial_support_index_path do |form| %><%= hidden_field_tag :operation, "toggle", id: nil %><%= select_field form, :enabled, "État du parcours", [["Désactivé", "0"], ["Activé", "1"]] %><div class="form-field"><%= form.check_box :validations %><%= form.label :validations, "La recette Stripe et les informations comptables et contractuelles ont été validées." %></div><%= input_field form, :reason, "Motif", required: true %><%= form.submit "Enregistrer l’état", class: "btn btn-primary" %><% end %></div><% end %>
<% @contributions.each do |record| %><div class="card"><h2>Soutien n° <%= record.id %></h2><p>Membre n° <%= record.user_id %> · <%= record.amount_cents %> centimes EUR · <%= community_status(record.status) %> · Remboursés : <%= record.refunded_cents %></p><% if current_user.permission?("financial.manage") %><%= form_with url: admin_financial_support_index_path do |form| %><%= hidden_field_tag :record_id, record.id, id: nil %><div class="form-field"><%= form.label :operation, "Action", for: "support-#{record.id}-operation" %><%= form.select :operation, current_user.super_admin? ? [["Rapprocher avec Stripe", "reconcile"], ["Rembourser intégralement", "refund"]] : [["Rapprocher avec Stripe", "reconcile"]], {}, id: "support-#{record.id}-operation", class: "control" %></div><%= input_field form, :reason, "Motif", required: true, id: "support-#{record.id}-reason" %><%= form.submit "Exécuter", class: "btn btn-outline" %><% end %><% end %></div><% end %>
