<div class="community-page"><h1>Confidentialité et conservation</h1><% if @requests %><h2>Demandes de droits</h2><% @requests.each do |record| %><article class="card"><h3>Demande n° <%= record.id %> · membre n° <%= record.user_id %></h3><p><%= human_value(record.kind) %> · <%= human_value(record.status) %> · échéance <%= l(record.response_due_at, format: :short) %></p><p><%= record.details %></p><p><%= record.response %></p><p><%= record.preview.to_json %></p><%= form_with url: admin_privacy_index_path do |form| %><%= hidden_field_tag :record_id, record.id, id: nil %><div class="form-field"><%= form.label :operation, "Action", for: "request-#{record.id}-action" %><%= form.select :operation, [["Préparer la décision", "review"], ["Seconde validation et exécution", "execute"], ["Préparer l’export", "export"]], {}, id: "request-#{record.id}-action", class: "control" %></div><%= input_field form, :response, "Réponse au demandeur et limites de l’effacement", type: :text_area, id: "request-#{record.id}-response" %><%= form.button "Traiter la demande", class: "btn btn-outline" %><% end %><% record.provider_erasure_tasks.each do |task| %><p>Propagation : <%= task.provider %> · <%= task.status %></p><%= form_with url: admin_privacy_index_path do |form| %><%= hidden_field_tag :operation, "provider", id: nil %><%= hidden_field_tag :record_id, task.id, id: nil %><%= input_field form, :response, "Confirmation du prestataire", required: true, id: "provider-#{task.id}-response" %><%= input_field form, :reason, "Motif", required: true, id: "provider-#{task.id}-reason" %><%= form.button "Enregistrer la confirmation", class: "btn btn-outline" %><% end %><% end %></article><% end %><% end %>
<% if @policies %><h2>Politiques par finalité</h2><% @policies.each do |policy| %><article class="card"><h3><%= policy.name %> · <%= policy.status %></h3><p><%= policy.rules.to_json %></p><p><%= policy.simulation.to_json %></p><%= form_with url: admin_privacy_index_path do |form| %><%= hidden_field_tag :record_id, policy.id, id: nil %><div class="form-field"><%= form.label :operation, "Action de politique", for: "policy-#{policy.id}-action" %><%= form.select :operation, [["Simuler", "simulate"], ["Publier après revue juridique", "publish"]], {}, id: "policy-#{policy.id}-action", class: "control" %></div><%= input_field form, :reason, "Motif", required: true, id: "policy-#{policy.id}-reason" %><%= form.button "Exécuter l’action", class: "btn btn-outline" %><% end %></article><% end %>
<div class="card"><h3>Nouvelle politique</h3><%= form_with url: admin_privacy_index_path do |form| %><%= hidden_field_tag :operation, "policy", id: nil %><%= input_field form, :name, "Nom", required: true %><p>Les durées proposées sont des brouillons à valider juridiquement. Les exports expirent toujours après un jour.</p><% RetentionPolicyVersion::PURPOSES.each do |purpose| %><div class="form-field"><%= label_tag "retention-#{purpose}", "#{human_value(purpose)} : durée en jours" %><%= number_field_tag "rules[#{purpose}]", purpose == "exports" ? 1 : 30, min: 1, max: purpose == "exports" ? 1 : 3650, required: true, id: "retention-#{purpose}", class: "control" %></div><% end %><%= input_field form, :effective_at, "Prise d’effet future", type: :datetime_local_field, required: true %><%= input_field form, :expires_at, "Fin de validité", type: :datetime_local_field, required: true %><div class="form-field"><%= form.check_box :legal_reviewed %><%= form.label :legal_reviewed, "Ces durées ont été validées juridiquement pour les finalités indiquées." %></div><%= form.button "Créer le brouillon", class: "btn btn-primary" %><% end %></div><h2>Purges</h2><%= form_with url: admin_privacy_index_path do |form| %><%= hidden_field_tag :operation, "preview_purge", id: nil %><%= input_field form, :reason, "Motif de prévisualisation", required: true %><%= form.button "Prévisualiser les données concernées", class: "btn btn-outline" %><% end %><% @runs.each do |run| %><div class="card"><p>Simulation n° <%= run.id %> · <%= run.status %> · <%= run.targets.transform_values(&:size).to_json %></p><%= button_to "Seconde approbation et purge", admin_privacy_index_path, params: { operation: "purge", record_id: run.id }, class: "btn btn-outline" %></div><% end %><% end %></div>
