<% content_for :title, "Administration des Points Services" %><h1>Points Services</h1><p>Les ajustements utilisent le registre. Une correction conserve l’opération d’origine et inscrit son inverse.</p>
<% if @adjustments %><h2>Préparer un ajustement</h2><p>Au-delà de 100 PS en valeur absolue, un autre super-admin doit valider. L’aperçu expire après dix minutes et doit être refait si le solde change.</p><%= form_with url: admin_points_path, class: "card" do |f| %><%= f.hidden_field :operation, value: "preview" %><%= input_field f, :user_id, "Identifiant du membre", type: :number_field, required: true, min: 1 %><%= input_field f, :amount, "Variation en PS (positive ou négative)", type: :number_field, required: true %><%= input_field f, :reason, "Motif de l’ajustement", type: :text_area, required: true, maxlength: 500 %><%= f.submit "Prévisualiser", class: "btn btn-deep" %><% end %><% @adjustments.each do |adjustment| %><article class="card"><h3>Aperçu n° <%= adjustment.id %> · membre n° <%= adjustment.user_id %></h3><p><%= adjustment.balance_before %> → <%= adjustment.balance_before + adjustment.amount %> PS · variation <%= adjustment.amount %> PS</p><p><%= adjustment.reason %></p><% if adjustment.point_operation %><p>Opération n° <%= adjustment.point_operation_id %> enregistrée.</p><% else %><%= button_to "Confirmer cet ajustement", admin_points_path, params: { operation: "commit", record_id: adjustment.id }, class: "btn btn-primary" %><% end %></article><% end %><% end %>
<% if @claims %><h2>Preuves de récompense</h2><% @claims.each do |claim| %><article class="card"><h3>Preuve n° <%= claim.id %> · membre n° <%= claim.user_id %> · <%= claim.kind %></h3><p><%= claim.evidence %></p><p><%= claim.amount %> PS · <%= claim.period_key %> · <%= claim.point_rule_version.name %></p><p><%= claim.status %> · <%= claim.decision %></p><% if claim.status == "pending" %><%= render "action", operation: "review", record: claim, decision: "approved", label: "Valider la preuve et créditer" %><%= render "action", operation: "review", record: claim, decision: "rejected", label: "Refuser avec ce motif" %><% end %></article><% end %><% end %>
<% if @operations %><h2>Registre — opérations récentes</h2><% @operations.each do |operation| %><details class="card"><summary>Opération n° <%= operation.id %> · <%= operation.kind %> · <%= l operation.committed_at, format: :short %></summary><p><%= operation.reason %></p><% operation.point_entries.each do |entry| %><p>Compte n° <%= entry.point_account_id %> : <%= entry.amount %> PS ; solde après : <%= entry.balance_after %> PS.</p><% end %><% if current_user.super_admin? && current_user.permission?("points.adjust") && operation.kind != "reversal" && !operation.reversal %><%= render "action", operation: "reverse", record: operation, label: "Créer la compensation après médiation" %><% end %></details><% end %><% end %>
<% if @versions %><h2>Versions des barèmes</h2><% @versions.each do |version| %><details class="card"><summary><%= version.name %> · <%= version.status %> · effet le <%= l version.effective_at, format: :short %></summary><pre class="point-config"><%= JSON.pretty_generate(version.configuration) %></pre><% if version.simulation.present? %><h3>Simulation et version précédente</h3><pre class="point-config"><%= JSON.pretty_generate(version.simulation) %></pre><% end %><% if version.status != "published" %><%= render "action", operation: "simulate", record: version, label: "Simuler ce barème" %><% if current_user.super_admin? %><%= render "action", operation: "publish", record: version, label: "Publier à la date prévue" %><% end %><% elsif current_user.super_admin? %><%= render "action", operation: "rollback", record: version, label: "Restaurer ce barème dans une nouvelle version" %><% end %></details><% end %><% if current_user.super_admin? %><h2>Créer un barème</h2><p>Copiez une configuration existante puis modifiez les valeurs. Seules les clés et bornes autorisées sont acceptées ; aucune expression n’est exécutée. Les tranches en centimes sont inclusives et doivent se suivre sans trou.</p><%= form_with url: admin_points_path, class: "card" do |f| %><%= f.hidden_field :operation, value: "version" %><%= input_field f, :name, "Nom du barème", required: true, maxlength: 100 %><%= select_field f, :family, "Famille", [["Récompenses et niveaux", "engagement"], ["Valorisations indicatives", "valuation"]] %><%= input_field f, :effective_at, "Date d’effet future", type: :datetime_local_field, required: true %><%= input_field f, :configuration, "Configuration du barème", type: :text_area, required: true, rows: 15 %><%= input_field f, :reason, "Motif de création", type: :text_area, required: true, maxlength: 500 %><%= f.submit "Créer le brouillon", class: "btn btn-deep" %><% end %><% end %><% end %>
