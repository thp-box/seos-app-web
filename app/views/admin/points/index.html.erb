<% content_for :title, "Preuves de récompense" %><%= render "admin/shared/heading", title: "Preuves de récompense", description: "Validez ou refusez les preuves envoyées par les membres. Les montants sont calculés automatiquement par l’application." %>
<% if @claims.empty? %><section class="card account-empty"><h2>Aucune preuve à examiner</h2><p>Les nouvelles demandes apparaîtront ici.</p></section><% end %>
<div class="admin-proof-list"><% @claims.each do |claim| %><article class="card"><header class="admin-form-intro"><span class="eyebrow"><%= claim.status == "pending" ? "À examiner" : "Décision enregistrée" %></span><h2><%= claim.kind.humanize %> · <%= claim.user.profile&.display_name || "Membre ##{claim.user_id}" %></h2><p>Preuve n° <%= claim.id %> · <%= claim.amount %> PS · période <%= claim.period_key %></p></header><div class="admin-proof-content"><h3>Preuve transmise</h3><%= plain_paragraphs claim.evidence %></div><p><strong>Statut :</strong> <%= human_value claim.status %><% if claim.decision.present? %> · <%= claim.decision %><% end %></p><% if claim.status == "pending" %><div class="admin-proof-actions"><%= render "action", operation: "review", record: claim, decision: "approved", label: "Valider et créditer" %><%= render "action", operation: "review", record: claim, decision: "rejected", label: "Refuser la preuve" %></div><% end %></article><% end %></div>
