<%= form_with url: admin_points_path, class: "form-field" do |f| %><%= f.hidden_field :operation, value: operation %><%= f.hidden_field :record_id, value: record.id %><% if defined?(decision) && decision %><%= f.hidden_field :decision, value: decision %><% end %><%= input_field f, :reason, "Motif", type: :text_area, required: true, maxlength: 500, id: "reason-#{operation}-#{record.id}-#{defined?(decision) ? decision : ''}" %><%= f.submit label, class: "btn btn-outline" %><% end %>
