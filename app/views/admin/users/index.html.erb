<% content_for :title, "Membres" %>
<%= render "admin/shared/heading", title: "Membres", description: current_user.super_admin? ? "Gérez les accès, les coordonnées privées et les points depuis une seule liste." : "Consultez les membres et utilisez uniquement les actions autorisées." %>
<%= form_with url: admin_users_path, method: :get, class: "filters" do |form| %>
  <div class="form-field"><%= form.label :q, "Nom public ou identifiant" %><%= form.search_field :q, value: params[:q], class: "control" %></div>
  <div class="form-field"><%= form.label :role, "Rôle" %><%= form.select :role, User.roles.keys.map { |role| [ t("roles.#{role}"), role ] }, { include_blank: "Tous", selected: params[:role] }, class: "control" %></div>
  <div class="form-field"><%= form.label :status, "Statut" %><%= form.select :status, User.statuses.keys.map { |status| [ t("statuses.#{status}"), status ] }, { include_blank: "Tous", selected: params[:status] }, class: "control" %></div>
  <%= form.submit "Filtrer", class: "btn btn-deep" %>
<% end %>

<div class="admin-member-list" aria-label="Liste des membres">
  <div class="admin-member-list-heading"><strong><%= @total %> membres</strong><span>Page <%= @page %></span></div>
  <% @users.each do |user| %>
    <article class="admin-member-row" id="member-<%= user.id %>">
      <div class="admin-member-summary">
        <div class="admin-member-identity"><span class="network-avatar" aria-hidden="true"><%= (user.profile&.display_name.presence || "M").first.upcase %></span><div><h2><%= user.profile&.display_name || "Profil non renseigné" %></h2><%= link_to "Voir la fiche complète · ##{user.id}", admin_user_path(user) %></div></div>
        <div><span class="admin-member-label">Rôle</span><strong><%= t("roles.#{user.role}") %></strong></div>
        <div><span class="admin-member-label">Statut</span><strong><%= t("statuses.#{user.status}") %></strong></div>
        <% if current_user.super_admin? %><div><span class="admin-member-label">Points</span><strong><%= @point_balances.fetch(user.id, 0) %> PS</strong></div><% end %>
      </div>

      <% if current_user.super_admin? || (current_user.permission?("users.moderate") && user.member?) %>
        <details class="admin-member-actions">
          <summary>Gérer ce membre</summary>
          <div class="admin-member-action-grid">
            <% if current_user.super_admin? %>
              <section><h3>Coordonnées privées</h3><dl><dt>E-mail</dt><dd><%= user.email %></dd><dt>Téléphone</dt><dd><%= user.profile&.phone.presence || "Non renseigné" %></dd></dl></section>
              <section><h3>Points Services</h3><p>Solde actuel : <strong><%= @point_balances.fetch(user.id, 0) %> PS</strong></p>
                <%= form_with url: admin_user_path(user), method: :patch, class: "admin-compact-form" do |form| %><%= hidden_field_tag :operation, "point_preview", id: nil %><%= hidden_field_tag :return_to, "members", id: nil %><%= input_field form, :amount, "Variation", type: :number_field, required: true, placeholder: "+10 ou -5", id: "member-#{user.id}-amount" %><%= input_field form, :reason, "Motif", required: true, maxlength: 500, id: "member-#{user.id}-points-reason" %><%= form.submit "Préparer", class: "btn btn-outline" %><% end %>
                <% @point_adjustments.fetch(user.id, []).each do |adjustment| %><div class="admin-pending-action"><span><%= adjustment.balance_before %> → <%= adjustment.balance_before + adjustment.amount %> PS</span><%= button_to "Confirmer", admin_user_path(user), method: :patch, params: { operation: "point_commit", adjustment_id: adjustment.id, return_to: "members" }, class: "btn btn-primary" %></div><% end %>
              </section>
            <% end %>
            <section><h3>Accès au compte</h3>
              <% if current_user.super_admin? && user.member? && user.active? && user.id != current_user.id %><%= form_with url: admin_user_path(user), method: :patch, class: "admin-compact-form" do |form| %><%= hidden_field_tag :operation, "promote_admin", id: nil %><%= hidden_field_tag :return_to, "members", id: nil %><%= input_field form, :reason, "Motif de la promotion", required: true, maxlength: 500, id: "member-#{user.id}-promotion-reason" %><%= form.submit "Passer en administrateur", class: "btn btn-primary", data: { turbo_confirm: "Promouvoir ce membre en administrateur ?" } %><% end %><% end %>
              <% if current_user.permission?("users.moderate") && user.member? && %w[active suspended].include?(user.status) %><%= form_with url: admin_user_path(user), method: :patch, class: "admin-compact-form danger-zone" do |form| %><%= hidden_field_tag :status, user.suspended? ? "active" : "suspended" %><%= hidden_field_tag :return_to, "members", id: nil %><%= input_field form, :reason, "Motif de la décision", required: true, maxlength: 500, id: "member-#{user.id}-moderation-reason" %><%= form.submit user.suspended? ? "Réactiver le membre" : "Exclure le membre", class: "btn btn-deep", data: { turbo_confirm: "Confirmer cette décision ?" } %><% end %><% end %>
              <% unless user.member? %><p>Les comptes administratifs ne peuvent pas être exclus depuis cette liste.</p><% end %>
            </section>
          </div>
        </details>
      <% end %>
    </article>
  <% end %>
  <% if @total.zero? %><p class="empty-state">Aucun membre ne correspond à ces filtres.</p><% end %>
</div>
<%= render "shared/pagination", page: @page, total: @total %>
