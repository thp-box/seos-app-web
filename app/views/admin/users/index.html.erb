<% content_for :title, "Membres" %>
<%= render "admin/shared/heading", title: "Membres", description: "Les coordonnées personnelles sont masquées." %>
<%= form_with url: admin_users_path, method: :get, class: "filters" do |form| %>
  <div class="form-field"><%= form.label :q, "Nom public ou identifiant" %><%= form.search_field :q, value: params[:q], class: "control" %></div>
  <div class="form-field"><%= form.label :role, "Rôle" %><%= form.select :role, User.roles.keys.map { |role| [ t("roles.#{role}"), role ] }, { include_blank: "Tous", selected: params[:role] }, class: "control" %></div>
  <div class="form-field"><%= form.label :status, "Statut" %><%= form.select :status, User.statuses.keys.map { |status| [ t("statuses.#{status}"), status ] }, { include_blank: "Tous", selected: params[:status] }, class: "control" %></div>
  <%= form.submit "Filtrer", class: "btn btn-deep" %>
<% end %>
<div class="card table-scroll" tabindex="0" role="region" aria-label="Liste des membres">
<table><caption><%= @total %> membres</caption><thead><tr><th>Identifiant</th><th>Nom public</th><th>Rôle</th><th>Statut</th></tr></thead><tbody>
<% @users.each do |user| %><tr><td><%= link_to "Ouvrir ##{user.id}", admin_user_path(user) %></td><td><%= user.profile&.display_name || "Profil non renseigné" %></td><td><%= t("roles.#{user.role}") %></td><td><%= t("statuses.#{user.status}") %></td></tr><% end %>
</tbody></table><% if @total.zero? %><p class="empty-state">Aucun membre ne correspond à ces filtres.</p><% end %></div>
<%= render "shared/pagination", page: @page, total: @total %>
