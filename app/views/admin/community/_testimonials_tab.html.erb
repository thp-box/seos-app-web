<div class="admin-section-intro"><span class="admin-step-number">T</span><div><h2 id="community-tab-title">Témoignages</h2><p>Vérifiez le consentement et le contenu avant publication.</p></div></div>
<div class="community-record-list"><% @testimonials.each do |record| %><article class="card community-review-card"><div class="community-record-heading"><div><span class="network-badge network-badge-<%= record.status %>"><%= community_status(record.status) %></span><h3><%= record.display_name_snapshot %></h3></div><span>Consentement <%= l(record.consented_at, format: :short) %></span></div><blockquote><%= record.quote %></blockquote><%= plain_paragraphs record.transcript %><p>Version du consentement : <%= record.consent_version %></p><% if record.video.attached? && current_user.permission?("community.manage") %><%= link_to "Examiner la vidéo", media_path(record.video.attachment), class: "btn btn-outline" %><% end %><details><summary>Prendre une décision</summary><%= render "decision", record: record, operation: "review_testimonial", choices: [["Publier", "published"], ["Refuser", "rejected"], ["Réexaminer", "reexamine"], ["Retirer", "removed"]] %></details></article><% end %><% if @testimonials.empty? %><p class="network-empty">Aucun témoignage à examiner.</p><% end %></div>
