<% if current_user.permission?("community.manage") %><%= form_with url: admin_community_index_path do |form| %><%= hidden_field_tag :operation, operation, id: nil %><%= hidden_field_tag :record_id, record.id, id: nil %><div class="form-field"><%= form.label :decision, "Décision", for: "#{operation}-#{record.id}-decision" %><%= form.select :decision, choices, {}, id: "#{operation}-#{record.id}-decision", class: "control" %></div><% if operation == "review_top" %><%= input_field form, :days, "Durée en jours", type: :number_field, min: 1, max: CommunityPolicyVersion.current.top_max_days, value: [7, CommunityPolicyVersion.current.top_max_days].min, id: "top-#{record.id}-days" %><%= input_field form, :position, "Position", type: :number_field, min: 1, max: 100, value: 1, id: "top-#{record.id}-position" %><% end %><%= input_field form, :reason, "Motif de décision", type: :text_area, required: true, maxlength: 500, id: "#{operation}-#{record.id}-reason" %><%= form.submit "Enregistrer la décision", class: "btn btn-outline" %><% end %><% end %>
