<div class="admin-section-intro"><span class="admin-step-number">P</span><div><h2 id="community-tab-title">Preuves de quêtes</h2><p>Examinez la preuve transmise avant d’accorder la récompense.</p></div><span class="network-total"><strong><%= @records.size %></strong> à afficher</span></div>
<div class="community-record-list"><% @records.each do |record| %><article class="card community-review-card"><div class="community-record-heading"><div><span class="network-badge network-badge-<%= record.status %>"><%= community_status(record.status) %></span><h3><%= record.achievement.name %></h3></div><span>Membre n° <%= record.user_id %> · <%= record.points %> PS</span></div><dl><dt>Période</dt><dd><%= record.period_key %></dd><dt>Preuve déclarée</dt><dd><%= record.evidence %></dd><dt>Décision</dt><dd><%= record.decision.presence || "À examiner" %></dd></dl><% if record.proof.attached? && current_user.permission?("community.manage") %><%= link_to "Voir la preuve jointe", media_path(record.proof.attachment), class: "btn btn-outline" %><% end %><details><summary>Prendre une décision</summary><%= render "decision", record: record, operation: "review_quest", choices: [["Approuver", "approved"], ["Refuser", "rejected"], ["Réexaminer un refus", "reexamine"]] %></details></article><% end %><% if @records.empty? %><p class="network-empty">Aucune preuve à examiner.</p><% end %></div>
