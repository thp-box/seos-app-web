<div class="community-page">
<h1>Engagement et chaînes</h1><p>Les décisions sont motivées et auditées. Les montants proviennent des barèmes publiés ; aucune auto-attribution n’est autorisée.</p>
<% if current_user.permission?("community.manage") %>
<section class="quest-admin-catalog"><div class="quest-section-heading"><div><h2>Le catalogue des quêtes</h2><p>Choisissez une quête pour modifier son texte et son apparence. L’aperçu réagit à vos choix.</p></div><span class="quest-pill"><%= @achievements.count(&:active?) %> quêtes visibles</span></div>
<details class="card quest-admin-item"><summary>Créer une quête avec preuve</summary><%= render "quest_form", quest: Achievement.new %></details>
<% @achievements.each do |quest| %><details class="card quest-admin-item" name="quest-configuration"><summary><span class="quest-icon" data-accent="<%= quest.accent %>"><%= quest_icon(quest.icon, quest.event_name) %></span><span><strong><%= quest.name %></strong><small><%= quest_recurrence(quest) %> · <%= quest.active? ? "Visible" : "Archivée" %></small></span><span class="quest-edit-label">Modifier</span></summary><%= render "quest_form", quest: quest %></details><% end %>
</section>
<% end %>
<h2>Preuves de quêtes</h2><% @records.each do |record| %><div class="card"><h3><%= record.achievement.name %> · membre n° <%= record.user_id %></h3><p><%= community_status(record.status) %> · <%= record.points %> PS · <%= record.period_key %></p><p><%= record.evidence %></p><p><%= record.decision %></p><% if record.proof.attached? && current_user.permission?("community.manage") %><%= link_to "Voir la preuve", media_path(record.proof.attachment) %><% end %><%= render "decision", record: record, operation: "review_quest", choices: [["Approuver", "approved"], ["Refuser", "rejected"], ["Réexaminer un refus", "reexamine"]] %></div><% end %>
<h2>Mises en avant</h2><% @tops.each do |record| %><div class="card"><h3><%= record.listing.title %></h3><p><%= community_status(record.status) %> · <%= record.reason %></p><%= render "decision", record: record, operation: "review_top", choices: [["Approuver", "approved"], ["Refuser", "rejected"], ["Retirer", "withdrawn"]] %></div><% end %>
<h2>Témoignages</h2><% @testimonials.each do |record| %><div class="card"><h3><%= record.display_name_snapshot %> · <%= community_status(record.status) %></h3><p><%= record.quote %></p><p><%= record.transcript %></p><p>Consentement : <%= record.consent_version %>, <%= l(record.consented_at, format: :short) %></p><% if record.video.attached? && current_user.permission?("community.manage") %><%= link_to "Examiner la vidéo", media_path(record.video.attachment) %><% end %><%= render "decision", record: record, operation: "review_testimonial", choices: [["Publier", "published"], ["Refuser", "rejected"], ["Réexaminer", "reexamine"], ["Retirer", "removed"]] %></div><% end %>
<h2>Chaînes et médiation</h2><% @chains.each do |record| %><div class="card"><h3><%= record.name %> · n° <%= record.id %></h3><p><%= community_status(record.status) %> · <%= record.chain_rule_version.name %></p><ol><% record.chain_services.order(:position).each do |service| %><li>Service <%= service.position %> : membre <%= service.provider_id %> → <%= service.beneficiary_id || "en attente" %> · <%= community_status(service.status) %><p><%= service.description %></p><p><%= service.chain_rewards.sum(:points) %> PS attribués</p></li><% end %></ol><%= render "decision", record: record, operation: "chain", choices: [["Mettre en litige", "disputed"], ["Clôturer", "closed"], ["Réactiver", "active"]] %></div><% end %>
<% if current_user.super_admin? %><div class="card"><h2>Politique de visibilité</h2><p>Chaque modification conserve une version. Les dates déjà accordées restent inchangées.</p><%= form_with url: admin_community_index_path do |form| %><%= hidden_field_tag :operation, "policy", id: nil %><%= input_field form, :urgent_days, "Durée des prochaines urgences (jours)", type: :number_field, value: CommunityPolicyVersion.current.urgent_days, min: 1, max: 30, required: true %><%= input_field form, :top_max_days, "Durée maximale des prochaines mises en avant (jours)", type: :number_field, value: CommunityPolicyVersion.current.top_max_days, min: 1, max: 90, required: true %><%= input_field form, :reason, "Motif de politique", required: true, id: "policy-reason" %><%= form.submit "Publier cette politique", class: "btn btn-outline" %><% end %></div><% end %>
<% if @versions %><h2>Barèmes de chaînes</h2><% @versions.each do |version| %><div class="card"><h3><%= version.name %> · <%= community_status(version.status) %></h3><p><%= version.attributes.slice(*ChainRuleVersion::FIELDS).to_json %></p><p>Simulation : <%= version.simulation.to_json %></p><% if current_user.super_admin? %><%= form_with url: admin_community_index_path do |form| %><%= hidden_field_tag :record_id, version.id, id: nil %><div class="form-field"><%= form.label :operation, "Action sur le barème", for: "v#{version.id}-operation" %><%= form.select :operation, [["Simuler", "simulate"], ["Publier", "publish"], ["Copier pour retour à ce barème", "rollback"]], {}, id: "v#{version.id}-operation", class: "control" %></div><%= input_field form, :name, "Nom de la copie (si retour)", id: "v#{version.id}-name" %><%= input_field form, :effective_at, "Date de la copie (si retour)", type: :datetime_local_field, id: "v#{version.id}-date" %><%= input_field form, :reason, "Motif", required: true, id: "v#{version.id}-reason" %><%= form.submit "Exécuter", class: "btn btn-outline" %><% end %><% end %></div><% end %>
<% if current_user.super_admin? %><div class="card"><h3>Nouveau barème</h3><%= form_with url: admin_community_index_path do |form| %><%= hidden_field_tag :operation, "version", id: nil %><%= input_field form, :name, "Nom du barème", required: true, id: "new-rule-name" %><%= select_field form, :length_mode, "Longueur", [["Illimitée", "unlimited"], ["Limitée", "limited"]] %><%= input_field form, :max_links, "Nombre maximal (vide si illimitée)", type: :number_field, min: 1, max: 1000 %><%= select_field form, :reward_scope, "Bénéficiaires des points", [["Prestataire seulement", "provider_only"], ["Derniers N prestataires", "last_n_eligible"], ["Tous (chaîne limitée)", "all_eligible"]] %><% { rewarded_previous_links: ["Profondeur N", 1], points_per_validation: ["PS par bénéficiaire", 10], max_points_per_link: ["Plafond par validation", 30], max_points_per_member: ["Plafond par membre dans la chaîne", 100] }.each do |field, (label, value)| %><%= input_field form, field, label, type: :number_field, value: value, required: true, min: 1 %><% end %><%= input_field form, :effective_at, "Prise d’effet future", type: :datetime_local_field, required: true %><%= input_field form, :reason, "Motif du barème", required: true, id: "new-rule-reason" %><%= form.submit "Créer le brouillon", class: "btn btn-primary" %><% end %></div><% end %><% end %>

</div>
