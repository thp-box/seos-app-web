<div class="admin-section-intro"><span class="admin-step-number">R</span><div><h2 id="community-tab-title">Réglages de visibilité</h2><p>Ces durées s’appliquent uniquement aux prochaines décisions.</p></div></div>
<% if current_user.super_admin? %><div class="card"><%= form_with url: admin_community_index_path, class: "admin-form-surface" do |form| %><%= hidden_field_tag :operation, "policy", id: nil %><div class="admin-form-grid"><%= input_field form, :urgent_days, "Durée des prochaines urgences (jours)", type: :number_field, value: CommunityPolicyVersion.current.urgent_days, min: 1, max: 30, required: true %><%= input_field form, :top_max_days, "Durée maximale des mises en avant (jours)", type: :number_field, value: CommunityPolicyVersion.current.top_max_days, min: 1, max: 90, required: true %></div><%= input_field form, :reason, "Motif de cette modification", required: true, id: "policy-reason" %><div class="admin-form-actions"><span>Une nouvelle version de la politique sera conservée.</span><%= form.submit "Publier ces réglages", class: "btn btn-primary" %></div><% end %></div><% else %><p class="notice">Ces réglages sont réservés au super-administrateur.</p><% end %>
