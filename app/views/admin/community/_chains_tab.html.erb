<div class="admin-section-intro"><span class="admin-step-number">C</span><div><h2 id="community-tab-title">Chaînes et médiation</h2><p>Consultez le parcours complet avant de clôturer, réactiver ou placer une chaîne en litige.</p></div></div>
<div class="community-record-list"><% @chains.each do |record| %><article class="card community-review-card"><div class="community-record-heading"><div><span class="network-badge network-badge-<%= record.status %>"><%= community_status(record.status) %></span><h3><%= record.name %></h3></div><span>Chaîne n° <%= record.id %></span></div><ol class="community-chain-steps"><% record.chain_services.order(:position).each do |service| %><li><span><%= service.position %></span><div><strong>Membre <%= service.provider_id %> → <%= service.beneficiary_id || "en attente" %></strong><p><%= service.description %></p><small><%= community_status(service.status) %> · <%= service.chain_rewards.sum(:points) %> PS attribués</small></div></li><% end %></ol><details><summary>Ouvrir les outils de médiation</summary><%= render "decision", record: record, operation: "chain", choices: [["Mettre en litige", "disputed"], ["Clôturer", "closed"], ["Réactiver", "active"]] %></details></article><% end %><% if @chains.empty? %><p class="network-empty">Aucune chaîne à suivre.</p><% end %></div>
