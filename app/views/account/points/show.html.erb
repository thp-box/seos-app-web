<% content_for :title, "Mon portefeuille" %>
<h1>Mon portefeuille</h1>
<section class="card"><h2><%= @account&.balance || 0 %> Points Services</h2><p>Votre niveau de récompenses : <%= {"bronze" => "Bronze", "silver" => "Argent", "gold" => "Gold"}.fetch(@level) %>. Le solde et le niveau ne modifient pas votre Trust Score.</p><%= link_to "Comprendre les points et les barèmes", points_explanation_path %></section>
<% if @rule && !PointOperation.exists?(idempotency_key: "welcome:#{current_user.id}") %><section class="card"><h2>Terminer ma quête d’accueil</h2><p>Un e-mail confirmé et un profil publié donnent droit à <%= @rule.configuration["welcome"] %> PS, une seule fois.</p><%= button_to "Valider mon accueil", account_points_path, params: { operation: "welcome" }, class: "btn btn-primary" %></section><% end %>
<h2>Historique</h2>
<% @entries.each do |entry| %><article class="card"><h3><%= entry.amount.positive? ? "+" : "−" %><%= entry.amount.abs %> PS · solde après opération : <%= entry.balance_after %> PS</h3><p><%= entry.point_operation.reason %></p><p><%= l entry.created_at, format: :short %><% if entry.point_operation.point_rule_version %> · <%= entry.point_operation.point_rule_version.name %><% end %></p><% if entry.point_operation.source_type == "ServiceRequest" %><%= link_to "Voir mon échange", account_service_request_path(entry.point_operation.source_id) %><% end %></article><% end %>
<% if @entries.empty? %><p>Aucune opération pour le moment.</p><% end %><%= render "shared/pagination", page: @page, total: @total %>
<h2>Soumettre une preuve de quête</h2><p>La validation humaine précède le crédit. Témoignages : une fois. Partage et preuve de chaîne : une fois par mois, dans les plafonds du barème. Pour une chaîne, fournissez les références des services réellement validés.</p>
<%= form_with url: account_points_path, class: "card" do |f| %><%= f.hidden_field :operation, value: "claim" %><%= select_field f, :kind, "Quête", [["Témoignage écrit", "written"], ["Témoignage vidéo", "video"], ["Partage mensuel de SEOS", "share"]] %><%= input_field f, :evidence, "Preuve et contexte (privés, sans coordonnées de tiers)", type: :text_area, required: true, maxlength: 3000 %><%= f.submit "Demander la validation", class: "btn btn-deep" %><% end %>
<% @claims.each do |claim| %><article class="card"><h3>Demande n° <%= claim.id %> · <%= {"pending" => "En attente", "approved" => "Validée", "rejected" => "Refusée"}.fetch(claim.status) %></h3><p><%= claim.evidence %></p><p><%= claim.decision %></p><p><%= claim.amount %> PS prévus · <%= claim.point_rule_version.name %> · période <%= claim.period_key %></p></article><% end %>
