<%= account_page_heading "Mes notifications", eyebrow: "Toute votre activité" %>
<p>Retrouvez les nouvelles de chaque rubrique. Ouvrir une notification la marque comme lue ; ouvrir le menu du profil ne les efface pas.</p>
<nav class="notification-filters" aria-label="Filtrer les notifications"><%= link_to "Toutes", account_notifications_path, class: "btn btn-outline", aria: { current: ("page" unless @category) } %><% Notification::CATEGORIES.each do |key, label| %><% if @available_categories.include?(key) || @category == key %><%= link_to account_notifications_path(category: key), class: "btn btn-outline", aria: { current: ("page" if @category == key) } do %><%= label %><%= notification_badge(key) %><% end %><% end %><% end %></nav>
<% if @unread_through %><%= button_to "Tout marquer comme lu dans cette sélection", read_all_account_notifications_path, method: :patch, params: { category: @category, through_id: @unread_through }, class: "btn btn-outline" %><% end %>
<div class="notification-list"><% @notifications.each do |notice| %><article class="card notification-item <%= 'is-unread' unless notice.read_at %>"><div><p class="account-eyebrow"><%= Notification::CATEGORIES.fetch(notice.category) %><% unless notice.read_at %><span class="badge">Non lue</span><% end %></p><h2><%= notice.title %></h2><small><%= l notice.created_at, format: :short %></small></div><div class="actions"><%= button_to "Ouvrir", open_account_notification_path(notice), method: :patch, class: "btn btn-deep" %><% unless notice.read_at %><%= button_to "Marquer comme lue", account_notification_path(notice), method: :patch, params: { category: @category }, class: "btn btn-outline" %><% end %></div></article><% end %></div>
<% if @notifications.empty? %><p class="card">Aucune notification dans cette rubrique pour le moment.</p><% end %>
<%= render "shared/pagination", page: @page, total: @total %>
<h2>Préférences</h2><%= form_with model: current_user, url: preferences_account_notifications_path, method: :patch do |f| %><label><%= f.check_box :email_notifications %> Recevoir les notifications par e-mail</label><%= f.submit "Enregistrer", class: "btn btn-deep" %><% end %>
