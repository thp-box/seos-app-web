<h1>Mes notifications</h1><% @notifications.each do |notice| %><article class="card"><p><%= notice.title %><% unless notice.read_at %> <span class="badge">Non lue</span><% end %></p><% if notice.service_request %><%= link_to "Voir l’échange", account_service_request_path(notice.service_request) %><% end %><% unless notice.read_at %><%= button_to "Marquer comme lue", account_notification_path(notice), method: :patch %><% end %></article><% end %><% if @notifications.empty? %><p>Aucune notification pour le moment.</p><% end %><h2>Préférences</h2><%= form_with model: current_user, url: preferences_account_notifications_path, method: :patch do |f| %><label><%= f.check_box :email_notifications %> Recevoir les notifications par e-mail</label><%= f.submit "Enregistrer", class: "btn btn-deep" %><% end %>
