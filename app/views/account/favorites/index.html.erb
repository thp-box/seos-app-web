<h1>Mes favoris</h1><p>Cette liste est privée.</p><% if @listings.empty? %><p>Aucune annonce disponible dans vos favoris.</p><% end %><div class="card-grid"><% @listings.each do |listing| %><div><%= render "listings/card", listing: listing %><%= button_to "Retirer des favoris", account_favorite_path(listing.id), method: :delete %></div><% end %></div>
