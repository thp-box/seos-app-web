<%= account_page_heading "Mes candidatures Voyage" %><p>Retrouvez vos candidatures et celles confiées à votre équipe.</p><% @applications.each do |application| %><article class="card"><h2><%= link_to application.volunteer_mission.title, account_mission_application_path(application) %></h2><p><%= network_label(application.status) %> · du <%= l(application.starts_on) %> au <%= l(application.ends_on) %></p></article><% end %><%= link_to "Découvrir les missions", volunteer_missions_path if FeatureFlag.voyage_enabled? %>
