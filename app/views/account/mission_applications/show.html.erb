<%= account_page_heading @mission.title, eyebrow: "Ma candidature" %><p><%= network_label(@application.status) %> · du <%= l(@application.starts_on) %> au <%= l(@application.ends_on) %></p><%= plain_paragraphs(@application.message) %>
<% if @application.status == "accepted" && @mission.publicly_visible? %><div class="card"><h2>Préparer l’arrivée</h2><p>Adresse communiquée par l’association : <%= @mission.private_address %></p></div><% end %>
<% if @application.manageable_by?(current_user) %><%= render "admin/network/transition", url: account_mission_application_path(@application), method: :patch, record: @application, operation: "decision", statuses: %w[accepted rejected] %><% elsif %w[pending accepted].include?(@application.status) %><%= button_to "Retirer ma candidature", account_mission_application_path(@application), method: :patch, params: { operation: "decision", status: "withdrawn", reason: "Retrait par le candidat" }, class: "btn btn-outline" %><% end %>
<section class="card"><h2>Conversation privée</h2><% @messages.each do |message| %><article><h3><%= public_name(message.user) %></h3><%= plain_paragraphs(message.body) %></article><% end %><% if %w[pending accepted].include?(@application.status) && @mission.publicly_visible? %><%= form_with url: account_mission_application_path(@application), method: :patch do |form| %><%= hidden_field_tag :operation, "message", id: nil %><%= hidden_field_tag :delivery_key, SecureRandom.uuid, id: nil %><%= input_field form, :body, "Mon message", type: :text_area, required: true, maxlength: 3000 %><%= form.button "Envoyer le message", class: "btn btn-primary" %><% end %><% end %></section>
