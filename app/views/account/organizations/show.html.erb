<% access = OrganizationPolicy.new(current_user, @organization) %>
<% tabs = [["overview", "Vue d’ensemble"]] %>
<% tabs << ["missions", "Mes missions"] if access.edit_content? %>
<% tabs << ["profile", "Mon association"] %>
<% tabs << ["team", "Mon équipe"] if access.manage_team? %>
<% initial = (@mission_editor || params[:mission_id].present? || params[:new_mission] == "1") ? "missions" : "overview" %>
<div class="organization-hub organization-hub-mission" data-controller="workspace-tabs" data-workspace-tabs-default-value="<%= initial %>">
  <%= link_to "← Mes associations", account_organizations_path, class: "organization-back" %>
  <header class="organization-banner"><div><span class="account-eyebrow">Espace missions communautaires</span><h1><%= @organization.name %></h1><p>Faites vivre vos projets associatifs et accueillez celles et ceux qui veulent aider.</p></div><span class="organization-status"><%= network_label(@organization.status) %></span></header>
  <nav class="workspace-tabs" aria-label="Rubriques de mon association" data-workspace-tabs-target="navigation"><% tabs.each do |key, label| %><button type="button" data-workspace-tabs-target="tab" data-key="<%= key %>" data-action="workspace-tabs#select keydown->workspace-tabs#keyboard"><%= label %></button><% end %></nav>
  <section id="workspace-overview" data-workspace-tabs-target="panel" data-key="overview"><div class="organization-overview"><article class="organization-next"><span class="account-eyebrow">Votre prochaine étape</span><h2><%= @organization.verified? ? "Votre prochaine mission commence ici." : "Préparons votre arrivée." %></h2><p><%= organization_next_step(@organization) %></p><% if access.edit_content? %><%= link_to "Préparer une mission →", account_organization_path(@organization, tab: "missions", new_mission: "1"), class: "btn btn-primary" %><% end %></article><aside class="organization-snapshot"><span class="account-eyebrow">En bref</span><div><strong><%= @mission_total %></strong><span>missions préparées</span></div><div><strong><%= @memberships.size %></strong><span>membres dans l’équipe</span></div><% if @organization.publicly_visible? %><%= link_to "Voir ma fiche publique ↗", association_path(@organization), class: "btn btn-outline" %><% end %><%= link_to "Gérer les candidatures →", account_mission_applications_path, class: "btn btn-outline" %></aside></div></section>
  <% if access.edit_content? %><section id="workspace-missions" data-workspace-tabs-target="panel" data-key="missions"><%= render "missions", access: access %></section><% end %>
  <section id="workspace-profile" data-workspace-tabs-target="panel" data-key="profile"><p class="organization-panel-intro">Votre présentation aide la communauté à vous connaître. Les coordonnées légales restent privées.</p><%= render "profile", access: access %></section>
  <% if access.manage_team? %><section id="workspace-team" data-workspace-tabs-target="panel" data-key="team"><%= render "team", access: access %></section><% end %>
</div>
