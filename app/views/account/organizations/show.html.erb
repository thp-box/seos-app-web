<div class="community-page network-workspace">
<%= account_page_heading @organization.name, eyebrow: "Mon organisation" %><p><%= network_label(@organization.status) %> · <%= @organization.published_at ? "Fiche publique publiée" : "Présentation en préparation" %></p>
<% access = OrganizationPolicy.new(current_user, @organization) %>
<div class="card"><h2>Présentation de l’organisation</h2><%= form_with model: @organization, url: account_organization_path(@organization), multipart: true do |form| %><%= hidden_field_tag :operation, "profile", id: nil %><%= form.hidden_field :lock_version %><%= input_field form, :name, "Nom public", required: true %><%= input_field form, :description, "Présentation publique", type: :text_area, required: true %><%= input_field form, :public_location, "Ville ou région publique" %>
<% if access.owner? %><%= input_field form, :legal_name, "Dénomination légale (privée)" %><%= input_field form, :registration_number, "Numéro d’enregistrement (privé)" %><%= input_field form, :legal_email, "E-mail légal (privé)", type: :email_field %><% end %>
<div class="form-field"><%= label_tag :organization_logo, "Logo JPEG, PNG ou WebP (5 Mo maximum)" %><%= file_field_tag :logo, id: :organization_logo, accept: "image/jpeg,image/png,image/webp", class: "control" %></div><%= form.button "Enregistrer et demander une nouvelle revue", class: "btn btn-primary" %><% end %></div>
<details class="card"><summary>Aperçu public de la fiche</summary><%= render "associations/profile", organization: @organization %></details>
<% if access.manage_team? %><div class="card"><h2>Équipe</h2><p>Plusieurs propriétaires sont possibles ; le dernier ne peut pas être retiré. Un responsable peut gérer les éditeurs.</p>
<% @memberships.each do |membership| %><article><h3><%= public_name(membership.user) %></h3><p><%= t("membership_roles.#{membership.role}") %></p><% if access.owner? || membership.editor? %><%= form_with url: account_organization_path(@organization), method: :patch do |form| %><%= hidden_field_tag :operation, "membership", id: nil %><%= hidden_field_tag :record_id, membership.id, id: nil %><div class="form-field"><%= form.label :role, "Rôle", for: "member-#{membership.id}-role" %><%= form.select :role, (access.owner? ? %w[owner manager editor] : %w[editor]).map { |role| [t("membership_roles.#{role}"),role] }, { selected: membership.role }, id: "member-#{membership.id}-role", class: "control" %></div><div class="form-field"><%= form.label :status, "Accès", for: "member-#{membership.id}-status" %><%= form.select :status, [["Actif", "active"], ["Retiré", "revoked"]], {}, id: "member-#{membership.id}-status", class: "control" %></div><%= form.button "Modifier ce membre", class: "btn btn-outline" %><% end %><% end %></article><% end %>
<h3>Inviter dans l’équipe</h3><%= form_with url: account_organization_path(@organization), method: :patch, data: { turbo: false } do |form| %><%= hidden_field_tag :operation, "invite", id: nil %><%= input_field form, :email, "E-mail du compte destinataire", type: :email_field, required: true %><%= select_field form, :role, "Rôle proposé", (access.owner? ? %w[editor manager] : %w[editor]).map { |role| [t("membership_roles.#{role}"), role] } %><%= form.button "Créer une invitation privée", class: "btn btn-primary" %><% end %>
<% @invitations.each do |invitation| %><% if invitation.available? %><p>Invitation <%= invitation.id %> · expire le <%= l(invitation.expires_at, format: :short) %></p><%= button_to "Révoquer cette invitation", account_organization_path(@organization), method: :patch, params: { operation: "revoke_invitation", record_id: invitation.id }, class: "btn btn-outline" %><% end %><% end %>
<p><%= link_to "Gérer les candidatures et conversations", account_mission_applications_path %></p></div><% end %>
<% if access.edit_content? %>
<% if @organization.association? %><section><h2>Missions du Voyage solidaire</h2><% @missions.reject(&:new_record?).each do |mission| %><article class="card"><h3><%= mission.title %></h3><p><%= network_label(mission.status) %></p><%= link_to "Modifier ou voir l’aperçu", account_organization_path(@organization, mission_id: mission.id) %><%= render "admin/network/transition", url: account_organization_path(@organization), method: :patch, record: mission, operation: "mission_transition", statuses: %w[pending_review paused archived] %></article><% end %><%= render "volunteer_missions/form", mission: @mission, url: account_organization_path(@organization), method: :patch, admin: false %><% if @mission.persisted? %><details class="card"><summary>Aperçu de la mission</summary><%= render "volunteer_missions/details", mission: @mission %></details><% end %></section><% end %>
<section><h2>Partenariats</h2><% @partnerships.reject(&:new_record?).each do |record| %><article class="card"><h3><%= record.public_title %></h3><p><%= network_label(record.status) %></p><%= link_to "Modifier ou voir l’aperçu", account_organization_path(@organization, partnership_id: record.id) %><%= render "admin/network/transition", url: account_organization_path(@organization), method: :patch, record: record, operation: "partnership_transition", statuses: %w[pending_review] %></article><% end %><%= render "partnerships/form", record: @partnership, url: account_organization_path(@organization), method: :patch, admin: false %><% if @partnership.persisted? %><details class="card"><summary>Aperçu du partenariat</summary><%= render "partnerships/details", record: @partnership %></details><% end %></section>
<% end %>

</div>
