<div class="organization-hub" data-controller="workspace-tabs" data-workspace-tabs-default-value="<%= @organizations.empty? ? 'new' : 'spaces' %>">
  <header class="organization-intro"><span class="account-eyebrow">Agir avec une association</span><h1>Des missions à faire grandir ensemble.</h1><p>Créez l’espace de votre association, mobilisez des bénévoles et publiez vos missions après validation.</p></header>
  <nav class="workspace-tabs" aria-label="Mes associations"><button type="button" data-workspace-tabs-target="tab" data-key="spaces" data-action="workspace-tabs#select keydown->workspace-tabs#keyboard">Mes associations <span><%= @organizations.size %></span></button><button type="button" data-workspace-tabs-target="tab" data-key="new" data-action="workspace-tabs#select keydown->workspace-tabs#keyboard">Ajouter une association</button></nav>
  <section id="workspace-spaces" data-key="spaces" data-workspace-tabs-target="panel"><div class="organization-space-grid"><% @organizations.each do |organization| %><article class="organization-space-card organization-space-mission"><div class="organization-space-top"><span class="account-eyebrow">Missions communautaires</span><span class="organization-status"><%= network_label(organization.status) %></span></div><h2><%= organization.name %></h2><p><%= organization_next_step(organization) %></p><% unless organization.suspended? %><%= link_to "Ouvrir mon espace associatif →", account_organization_path(organization), class: "btn btn-deep" %><% end %></article><% end %></div><% if @organizations.empty? %><article class="organization-next"><h2>Votre première mission vous attend.</h2><p>Présentez votre association. L’équipe SEOS vérifiera la demande avant toute publication.</p></article><% end %></section>
  <section id="workspace-new" data-key="new" data-workspace-tabs-target="panel"><%= form_with url: account_organizations_path, scope: :organization, class: "organization-request-form" do |form| %><fieldset><legend>Présenter mon association</legend><p class="help">Cet espace sert uniquement aux associations et à leurs missions communautaires.</p><%= render "request_fields", form: form %></fieldset><div class="organization-form-submit"><p>La demande reste privée jusqu’à sa vérification.</p><%= form.button "Envoyer ma demande de vérification", class: "btn btn-primary" %></div><% end %></section>
  <nav class="organization-discover" aria-label="Découvrir les projets publics"><%= link_to "Les associations ↗", associations_path %><% if FeatureFlag.voyage_enabled? %><%= link_to "Les missions solidaires ↗", volunteer_missions_path %><% end %><%= link_to "Nos partenaires ↗", partnership_page_path %></nav>
</div>
