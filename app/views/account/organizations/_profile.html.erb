<div class="card"><h2>Présentation de l’organisation</h2><%= form_with model: @organization, url: account_organization_path(@organization), multipart: true do |form| %><%= hidden_field_tag :operation, "profile", id: nil %><%= form.hidden_field :lock_version %><%= input_field form, :name, "Nom public", required: true %><%= input_field form, :description, "Présentation publique", type: :text_area, required: true %><%= input_field form, :public_location, "Ville ou région publique" %>
<% if access.owner? %><%= input_field form, :legal_name, "Dénomination légale (privée)" %><%= input_field form, :registration_number, "Numéro d’enregistrement (privé)" %><%= input_field form, :legal_email, "E-mail légal (privé)", type: :email_field %><% end %>
<div class="form-field"><%= label_tag :organization_logo, "Logo JPEG, PNG ou WebP (5 Mo maximum)" %><%= file_field_tag :logo, id: :organization_logo, accept: "image/jpeg,image/png,image/webp", class: "control" %></div><%= form.button "Enregistrer et demander une nouvelle revue", class: "btn btn-primary" %><% end %></div>
<details class="card"><summary>Aperçu public de la fiche</summary><%= render "associations/profile", organization: @organization %></details>
