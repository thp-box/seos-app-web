<div class="mission-editor">
  <h2><%= mission.persisted? ? "Modifier ma mission" : "Créer une mission communautaire" %></h2>
  <p>Enregistrez un brouillon pour préparer votre projet. La publication intervient après validation par SEOS.</p>
  <% if mission.persisted? && mission.status != "draft" %><p class="notice">Enregistrer vos modifications remet la mission en brouillon et retire sa publication. Une nouvelle validation sera nécessaire.</p><% end %>
  <% if @mission_error %><p class="notice" role="alert"><strong>Le brouillon n’a pas été enregistré.</strong> <%= @mission_error %></p><% end %>
  <%= form_with model: mission, scope: :mission, url: account_organization_path(@organization), method: :patch, multipart: true, data: { controller: "mission-form" } do |form| %>
    <%= hidden_field_tag :operation, "mission", id: nil %><%= hidden_field_tag :record_id, mission.id, id: nil %>
    <% { mission_search: @mission_search, mission_status: @mission_status, mission_sort: @mission_sort, mission_page: @mission_page }.each do |key, value| %><%= hidden_field_tag key, value, id: nil %><% end %>
    <% prefix = "mission-#{mission.id || 'new'}-" %>
    <nav class="mission-form-steps" aria-label="Étapes de création" data-mission-form-target="navigation" hidden>
      <% ["Le projet", "Le lieu", "Le calendrier", "L’accueil"].each_with_index do |label, index| %><button type="button" data-action="mission-form#go" data-step="<%= index %>" data-mission-form-target="tab"><span><%= index + 1 %></span> <%= label %></button><% end %>
    </nav>
    <fieldset class="organization-form-group" data-mission-form-target="panel"><legend>1. Présenter le projet</legend><p>Expliquez ce que les bénévoles vont faire et ce que leur aide rendra possible.</p>
      <%= input_field form, :title, "Titre de la mission", required: true, maxlength: 150, id: prefix + "title" %>
      <%= input_field form, :description, "Présentation publique", type: :text_area, maxlength: 5000, id: prefix + "description" %>
      <div class="form-field"><%= label_tag prefix + "photos", "Photos (6 maximum, 5 Mo par image)" %><%= file_field_tag "photos[]", id: prefix + "photos", multiple: true, accept: "image/jpeg,image/png,image/webp", class: "control" %></div>
      <% if mission.photos.attached? %><p><%= mission.photos.count %> photos déjà enregistrées. Les nouvelles photos s’ajouteront à celles-ci.</p><% end %>
    </fieldset>
    <fieldset class="organization-form-group" data-mission-form-target="panel"><legend>2. Situer la mission</legend><p>Le lieu public aide à découvrir votre projet. L’adresse précise reste privée jusqu’à l’acceptation de la candidature.</p>
      <div class="mission-field-grid">
        <%= input_field form, :country_code, "Pays (code à deux lettres, ex. FR)", maxlength: 2, id: prefix + "country" %>
        <%= input_field form, :region, "Région", id: prefix + "region" %>
        <%= input_field form, :public_location, "Localisation publique", id: prefix + "location" %>
        <%= input_field form, :private_address, "Adresse précise (privée)", id: prefix + "address" %>
      </div>
    </fieldset>
    <fieldset class="organization-form-group" data-mission-form-target="panel"><legend>3. Organiser le calendrier</legend><p>Définissez une période et un rythme d’accueil adaptés à votre équipe.</p>
      <div class="mission-field-grid">
        <%= input_field form, :starts_on, "Début de la mission", type: :date_field, id: prefix + "starts" %><%= input_field form, :ends_on, "Fin de la mission", type: :date_field, id: prefix + "ends" %>
        <% { minimum_stay_days: ["Séjour minimal en jours", 1, 365], help_hours_per_day: ["Heures d’aide par jour", 1, 8], days_off_per_week: ["Jours libres par semaine", 1, 6], volunteer_capacity: ["Bénévoles accueillis simultanément", 1, 100] }.each do |field, (label, min, max)| %><%= input_field form, field, label, type: :number_field, min: min, max: max, required: true, id: prefix + field.to_s %><% end %>
      </div>
    </fieldset>
    <fieldset class="organization-form-group" data-mission-form-target="panel"><legend>4. Préciser les conditions d’accueil</legend><p>Indiquez clairement ce qui est proposé pour permettre aux bénévoles de se projeter.</p>
      <%= input_field form, :accommodation, "Hébergement proposé", type: :text_area, id: prefix + "accommodation" %><%= input_field form, :meals, "Repas proposés", type: :text_area, id: prefix + "meals" %>
      <div class="mission-field-grid"><%= input_field form, :languages, "Langues parlées", id: prefix + "languages" %><%= input_field form, :daily_contribution_points, "Contribution par jour en Points Services", type: :number_field, min: 0, max: 100000, required: true, id: prefix + "points" %></div>
      <p>Enregistrer ce brouillon ne déclenche aucun transfert de Points Services.</p>
    </fieldset>
    <div class="mission-editor-actions">
      <div data-mission-form-target="controls" hidden><button type="button" class="btn btn-outline" data-action="mission-form#previous" data-mission-form-target="previous">← Précédent</button><button type="button" class="btn btn-deep" data-action="mission-form#next" data-mission-form-target="next">Continuer →</button></div>
      <%= form.button "Enregistrer le brouillon de mission", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
