<% if access.manage_team? %><div class="card"><h2>Équipe</h2><p>Plusieurs propriétaires sont possibles ; le dernier ne peut pas être retiré. Un responsable peut gérer les éditeurs.</p>
<% @memberships.each do |membership| %><article><h3><%= public_name(membership.user) %></h3><p><%= t("membership_roles.#{membership.role}") %></p><% if access.owner? || membership.editor? %><%= form_with url: account_organization_path(@organization), method: :patch do |form| %><%= hidden_field_tag :operation, "membership", id: nil %><%= hidden_field_tag :record_id, membership.id, id: nil %><div class="form-field"><%= form.label :role, "Rôle", for: "member-#{membership.id}-role" %><%= form.select :role, (access.owner? ? %w[owner manager editor] : %w[editor]).map { |role| [t("membership_roles.#{role}"),role] }, { selected: membership.role }, id: "member-#{membership.id}-role", class: "control" %></div><div class="form-field"><%= form.label :status, "Accès", for: "member-#{membership.id}-status" %><%= form.select :status, [["Actif", "active"], ["Retiré", "revoked"]], {}, id: "member-#{membership.id}-status", class: "control" %></div><%= form.button "Modifier ce membre", class: "btn btn-outline" %><% end %><% end %></article><% end %>
<h3>Inviter dans l’équipe</h3><%= form_with url: account_organization_path(@organization), method: :patch, data: { turbo: false } do |form| %><%= hidden_field_tag :operation, "invite", id: nil %><%= input_field form, :email, "E-mail du compte destinataire", type: :email_field, required: true %><%= select_field form, :role, "Rôle proposé", (access.owner? ? %w[editor manager] : %w[editor]).map { |role| [t("membership_roles.#{role}"), role] } %><%= form.button "Créer une invitation privée", class: "btn btn-primary" %><% end %>
<% @invitations.each do |invitation| %><% if invitation.available? %><p>Invitation <%= invitation.id %> · expire le <%= l(invitation.expires_at, format: :short) %></p><%= button_to "Révoquer cette invitation", account_organization_path(@organization), method: :patch, params: { operation: "revoke_invitation", record_id: invitation.id }, class: "btn btn-outline" %><% end %><% end %>
<p><%= link_to "Gérer les candidatures et conversations", account_mission_applications_path %></p></div><% end %>
