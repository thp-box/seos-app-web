<% content_for :title, "Mon profil" %><h1>Mon profil</h1><p>Votre pseudonyme, votre présentation et votre commune sont publics. Le téléphone et l’adresse restent privés.</p>
<%= render "shared/record_errors", record: @profile %>
<%= form_with model: @profile, url: account_profile_path, method: :patch, class: "card" do |f| %>
  <h2>Votre profil public</h2><%= input_field f, :display_name, "Pseudonyme public", required: true, maxlength: 80 %><%= input_field f, :bio, "Présentation sans coordonnées", type: :text_area, maxlength: 2000 %><%= input_field f, :public_city, "Commune ou zone large" %><%= input_field f, :skills, "Compétences" %><%= input_field f, :languages, "Langues" %><%= input_field f, :avatar, "Photo publique facultative — JPEG, PNG ou WebP, 5 Mo maximum", type: :file_field, accept: "image/jpeg,image/png,image/webp" %>
  <h2>Vos coordonnées privées</h2><%= input_field f, :phone, "Téléphone privé", type: :telephone_field %><%= input_field f, :address_line, "Adresse privée" %><%= select_field f, :phone_sharing_policy, "Partage des coordonnées", [["Uniquement après mon accord, pour un échange", "per_exchange"],["Ne jamais partager", "nobody"]] %><%= f.submit "Enregistrer mon profil", class: "btn btn-deep" %>
<% end %><% if @profile.persisted? && @profile.published? %><p><%= link_to "Voir mon profil comme un visiteur", profile_path(@profile) %></p><% end %>
