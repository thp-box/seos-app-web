<% content_for :title, "Vérifier mon identité" %>
<%= account_page_heading "Confirmer votre mot de passe" %><p>Cette confirmation est demandée pour une opération sensible sur votre compte.</p>
<%= form_with url: account_reauthentication_path do |form| %><div class="form-field"><%= form.label :password, "Mot de passe" %><div class="password-control" data-controller="password-visibility"><%= form.password_field :password, class: "control", autocomplete: "current-password", required: true, data: { password_visibility_target: "input" } %><button type="button" class="password-toggle" aria-label="Afficher le mot de passe" data-action="password-visibility#toggle"><svg data-password-visibility-target="showIcon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg><svg data-password-visibility-target="hideIcon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" hidden><path d="M3 3l18 18M10.6 6.2A10.6 10.6 0 0 1 12 6c6.5 0 10 6 10 6a17 17 0 0 1-2.1 2.8M6.2 6.2C3.4 8 2 12 2 12s3.5 6 10 6c1 0 2-.2 2.8-.5"/></svg></button></div></div><%= form.submit "Confirmer", class: "btn btn-deep" %><% end %>
