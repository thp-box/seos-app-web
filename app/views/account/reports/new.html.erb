<%= account_page_heading "Signaler à l’équipe SEOS" %><p>Votre signalement reste privé. Décrivez les faits pour permettre une revue humaine.</p><%= form_with scope: :report, url: account_reports_path(target_type: @target.class.name, target_id: @target.id), class: "card" do |f| %><%= input_field f, :reason, "Motif", required: true, maxlength: 200 %><%= input_field f, :details, "Précisions et éléments utiles", type: :text_area, maxlength: 3000 %><%= f.submit "Envoyer le signalement", class: "btn btn-deep" %><% end %>
