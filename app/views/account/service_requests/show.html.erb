<% content_for :title, "Échange · #{@request.listing.title}" %><%= link_to "Mes échanges", account_service_requests_path %><h1><%= @request.listing.title %></h1><p><span class="badge"><%= human_value @request.current_status %></span> Avec <%= public_name @request.other(current_user) %></p>
<%= render "points" %>
<% if @request.current_status == "pending" && current_user.id == @request.provider_id %><div class="actions"><% {"Accepter la demande" => "accept", "Refuser" => "decline"}.each do |label,event| %><%= button_to label, account_service_request_path(@request, event: event), method: :patch, class: "btn btn-deep" %><% end %></div><% end %>
<% if @request.agreement.present? %><section class="card"><h2>Votre accord · version <%= @request.agreement_version %></h2><p>Date : <%= @request.agreement["scheduled_at"] %></p><p>Lieu ou moyen : <%= @request.agreement["location"] %></p><p>Réalisation : <%= human_value @request.agreement["mode"] %></p><% if @request.agreement["points"] %><p><%= @request.agreement["points"] %> PS convenus</p><% end %><p><%= @request.agreement["consideration"] %></p><% if @request.accepted? %><%= button_to "Accepter cet accord", account_service_request_path(@request, event: "agree", agreement_version: @request.agreement_version), method: :patch, class: "btn btn-primary" %><% end %></section><% end %>
<% if %w[accepted scheduled].include?(@request.status) %><details class="card"><summary>Proposer ou modifier l’accord</summary><p>Toute modification demande une nouvelle acceptation des deux participants.</p><%= form_with url: account_service_request_path(@request), method: :patch do |f| %><%= hidden_field_tag :event, "propose" %><%= fields_for :terms do |t| %><%= input_field t, :scheduled_at, "Date prévue", type: :datetime_local_field, required: true %><%= input_field t, :location, "Lieu ou moyen de réalisation (privé)", required: true %><%= select_field t, :mode, "Réalisation", choices_for(Listing.service_location_modes.keys) %><% if @request.listing.exchange_mode_points? %><%= input_field t, :points, "Points Services convenus", type: :number_field, min: 1, required: true %><% end %><% if @request.listing.exchange_mode_barter? %><%= input_field t, :consideration, "Compétences échangées", required: true %><% end %><% end %><%= f.submit "Proposer cet accord", class: "btn btn-deep" %><% end %></details><% end %>
<% if %w[scheduled awaiting_confirmation].include?(@request.status) %><section class="card"><h2>Réalisation et coordonnées</h2><p>Chacun confirme une fois le service réalisé.</p><%= button_to (@request.agreement["points"].present? ? "Je confirme la réalisation et le transfert de #{@request.agreement["points"]} PS" : "Je confirme la réalisation"), account_service_request_path(@request, event: "confirm", agreement_version: @request.agreement_version), method: :patch, class: "btn btn-primary", disabled: (@request.agreement["payer_id"] == current_user.id && (PointAccount.find_by(user: current_user)&.balance || 0) < @request.agreement["points"].to_i) %><%= button_to "Partager mes coordonnées pour cet échange", account_service_request_path(@request, event: "share"), method: :patch %><%= button_to "Révoquer le partage de mes coordonnées", account_service_request_path(@request, event: "revoke"), method: :patch %><% @request.shared_contact_for(current_user).each do |field,value| %><p><strong><%= field == :phone ? "Téléphone partagé" : "Adresse partagée" %> :</strong> <%= value %></p><% end %></section><% end %>
<%= turbo_frame_tag "conversation" do %><section class="card conversation"><h2>Conversation privée</h2><% if @request.blocked? %><p>La prise de contact est bloquée.</p><% end %><% @messages.each do |message| %><article class="message <%= "mine" if message.sender_id == current_user.id %>"><strong><%= public_name message.sender %></strong><%= plain_paragraphs message.body %><% if message.attachment.attached? %><%= image_tag media_path(message.attachment.attachment), alt: "Image jointe au message", width: 400, height: 250 %><% end %><small><%= l message.created_at, format: :short %> · <%= message.read_at ? "Lu" : "Non lu" %></small><%= report_link message %></article><% end %><% unless @request.blocked? || %w[cancelled declined expired].include?(@request.current_status) %><%= form_with scope: :message, url: account_service_request_messages_path(@request) do |f| %><%= f.hidden_field :delivery_key, value: SecureRandom.uuid %><%= input_field f, :body, "Votre message", type: :text_area, required: true, maxlength: 5000 %><%= input_field f, :attachment, "Image facultative — JPEG, PNG ou WebP, 5 Mo maximum", type: :file_field, accept: "image/jpeg,image/png,image/webp" %><%= f.submit "Envoyer", class: "btn btn-deep" %><% end %><% end %></section><% end %>
<% if @request.completed? %><section class="card"><h2>Votre avis après l’échange</h2><% @reviews.each do |review| %><%= render "shared/review", review: review %><% if review.reviewee_id == current_user.id && review.revealed? %><%= form_with model: review, url: account_review_path(review) do |f| %><%= input_field f, :response, "Répondre à cet avis", type: :text_area %><%= f.submit "Publier ma réponse" %><% end %><% end %><% end %><% unless @request.reviews.exists?(author: current_user) || @request.completed_at < 30.days.ago %><p>Vous disposez de 30 jours. Les avis sont révélés après les deux réponses, ou après 14 jours.</p><%= form_with scope: :review, url: account_service_request_reviews_path(@request) do |f| %><%= select_field f, :completion_answer, "Le service a-t-il été réalisé ?", [["Oui","yes"],["Partiellement","partially"],["Non","no"]] %><%= select_field f, :would_reengage, "Referiez-vous un échange ?", [["Oui","true"],["Non","false"]] %><% @criteria.each do |criterion| %><div class="form-field"><%= label_tag "ratings_#{criterion.id}", criterion.label %><%= select_tag "ratings[#{criterion.id}]", options_for_select([["Choisir", ""],["Non applicable", "na"]] + (1..5).map { |n| ["#{n}/5",n] }), id: "ratings_#{criterion.id}", class: "control", required: true %></div><% end %><%= input_field f, :factual_body, "Commentaire factuel facultatif, sans coordonnées", type: :text_area %><%= f.submit "Déposer mon avis", class: "btn btn-deep" %><% end %><% end %></section><% end %>
<% if %w[pending accepted scheduled awaiting_confirmation].include?(@request.current_status) %><details class="card"><summary>Annuler ou demander une médiation</summary><%= form_with url: account_service_request_path(@request), method: :patch do |f| %><%= select_field f, :event, "Votre demande", [["Annuler sans attribution de faute", "cancel"],["Ouvrir un litige", "dispute"]] %><%= input_field f, :reason, "Motif privé", type: :text_area, required: true, maxlength: 1000 %><%= f.submit "Confirmer", class: "btn btn-outline" %><% end %></details><% end %>
<details class="card"><summary>Historique de l’échange</summary><ol><% @events.each do |event| %><li><%= l event.created_at, format: :short %> — <%= human_value event.kind %> · <%= public_name event.actor %></li><% end %></ol></details><%= button_to "Bloquer ce membre", account_user_blocks_path(service_request_id: @request.id), class: "btn btn-outline" %><%= report_link @request %>
