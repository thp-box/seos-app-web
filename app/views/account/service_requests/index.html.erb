<%= account_page_heading "Mes échanges" %><%= form_with url: account_service_requests_path, method: :get, class: "filters" do |f| %><%= select_field f, :box, "Boîte", [["Toutes", ""],["Demandes reçues", "received"],["Demandes envoyées", "sent"]], selected: params[:box] %><%= select_field f, :status, "Statut", choices_for(ServiceRequest.statuses.keys), include_blank: "Tous", selected: params[:status] %><%= f.submit "Filtrer", class: "btn btn-outline" %><% end %><% if @requests.empty? %><div class="card empty-state"><h2>Vos échanges commencent par une rencontre.</h2><p><%= link_to "Parcourir les annonces", listings_path %></p></div><% end %><div class="account-exchange-grid"><% @requests.each do |request| %><article class="card"><span class="badge"><%= human_value request.current_status %></span><h2><%= link_to request.listing.title, account_service_request_path(request) %></h2><p>Avec <%= public_name request.other(current_user) %></p></article><% end %>
</div>