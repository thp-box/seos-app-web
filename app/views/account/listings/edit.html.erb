<h1>Votre annonce</h1><p>Votre brouillon est enregistré à chaque étape. Vous pourrez le reprendre depuis « Mes annonces ».</p><nav class="wizard-steps" aria-label="Étapes de publication"><% ["Votre intention", "Les détails", "Les photos", "Aperçu"].each_with_index do |label, index| %><%= link_to "#{index + 1}. #{label}", (@listing.persisted? ? edit_account_listing_path(@listing, step: index + 1) : new_account_listing_path), aria: { current: ("step" if @step == index + 1) } %><% end %></nav>
<%= render "shared/record_errors", record: @listing %>
<%= form_with model: @listing, url: (@listing.persisted? ? account_listing_path(@listing, step: @step) : account_listings_path(step: @step)), method: (@listing.persisted? ? :patch : :post), class: "card" do |f| %><%= f.hidden_field :lock_version %><% if @listing.organization %><%= hidden_field_tag :organization_slug, @listing.organization.slug %><p>Publication au nom de <strong><%= @listing.organization.name %></strong>.</p><% end %>
<% case @step; when 1 %><h2>Que souhaitez-vous partager ?</h2><%= select_field f, :intent, "Votre intention", choices_for(Listing.intents.keys) %><%= select_field f, :category_id, "Catégorie", @categories.map { |c| [c.name,c.id] }, include_blank: "Choisir une catégorie" %><%= select_field f, :exchange_mode, "Mode d’échange", choices_for(Listing.exchange_modes.keys) %><%= input_field f, :estimated_points, "Estimation PS — uniquement en mode Points Services", type: :number_field, min: 1 %><%= select_field f, :service_location_mode, "Comment se déroule le service ?", choices_for(Listing.service_location_modes.keys) %>
<% when 2 %><h2>Racontez votre service</h2><%= input_field f, :title, "Titre", required: true, maxlength: 120 %><%= input_field f, :description, "Description publique sans coordonnées", type: :text_area, required: true, rows: 6, maxlength: 5000 %><%= input_field f, :city, "Commune publique — inutile pour un service à distance" %><%= input_field f, :address_line, "Adresse exacte privée" %><%= input_field f, :availability, "Disponibilités", type: :text_area %><%= select_field f, :priority, "Priorité", choices_for(%w[standard urgent]) %>
<% when 3 %><h2>Montrez votre savoir-faire</h2><p>Quatre photos maximum, JPEG/PNG/WebP, 5 Mo par image. Les métadonnées seront retirées. N’ajoutez pas de document d’identité ou de coordonnées visibles.</p><%= input_field f, :photos, "Ajouter des photos", type: :file_field, multiple: true, accept: "image/jpeg,image/png,image/webp" %><div class="gallery"><% @listing.photos.each do |photo| %><%= image_tag media_path(photo), alt: "Photo de votre brouillon", width: 400, height: 250 %><% end %></div>
<% when 4 %><h2><%= @listing.title.presence || "Titre à compléter" %></h2><%= plain_paragraphs @listing.description %><p><%= human_value @listing.intent %> · <%= human_value @listing.exchange_mode %> · <%= @listing.location_label %></p><p><%= @listing.estimated_points %> PS estimés <% unless @listing.exchange_mode_points? %>(sans objet pour ce mode)<% end %></p><% end %>
<%= f.submit @step == 4 ? "Enregistrer le brouillon" : "Enregistrer et continuer", class: "btn btn-deep" %><% end %>
<% if @step == 4 %><%= form_with url: transition_account_listing_path(@listing), method: :patch, class: "card" do |f| %><%= hidden_field_tag :event, "publish" %><label class="checkbox-label"><%= check_box_tag :privacy_confirmed, "1", false, required: true %> Les informations publiques et les photos ne contiennent pas mes coordonnées privées.</label><%= f.submit "Publier mon annonce", class: "btn btn-primary" %><% end %><% end %>
