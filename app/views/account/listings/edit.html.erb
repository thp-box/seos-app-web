<% content_for :title, "Créer une annonce" %>
<div class="listing-wizard-page">
  <div class="listing-wizard-shell">
    <div class="listing-wizard-intro"><%= link_to "← Mes annonces", account_listings_path %><span>Brouillon enregistré à chaque étape</span></div>
    <nav aria-label="Étapes de publication"><ol class="listing-stepper">
      <% ["Intention", "Échange", "Détails", "Aperçu"].each_with_index do |label, index| %><li class="<%= 'is-complete' if index + 1 <= @step %>"><%= link_to (@listing.persisted? ? edit_account_listing_path(@listing, step: index + 1) : new_account_listing_path), aria: { current: ("step" if @step == index + 1) } do %><span><%= index + 1 %></span><%= label %><% end %></li><% end %>
    </ol></nav>
    <section class="listing-wizard-card" data-controller="listing-wizard">
      <header><div><span class="eyebrow">Étape <%= @step %> sur 4</span><h1><%= ["Que souhaitez-vous faire ?", "Comment souhaitez-vous échanger ?", "Présentez votre annonce", "Vérifiez avant de publier"][@step - 1] %></h1></div><span class="listing-wizard-icon"><%= quest_icon(["people", "link", "listing", "trophy"][@step - 1]) %></span></header>
      <%= render "shared/record_errors", record: @listing %>
      <% if @listing.organization %><p class="listing-wizard-context">Publication au nom de <strong><%= @listing.organization.name %></strong>.</p><% end %>
      <% if @step < 4 %>
        <%= form_with model: @listing, url: (@listing.persisted? ? account_listing_path(@listing, step: @step) : account_listings_path(step: @step)), method: (@listing.persisted? ? :patch : :post) do |f| %>
          <%= f.hidden_field :lock_version %><%= hidden_field_tag :organization_slug, @listing.organization.slug if @listing.organization %>
          <div class="listing-wizard-body">
            <% if @step == 1 %>
              <fieldset class="listing-choices"><legend class="sr-only">Votre intention</legend>
              <% [["offer", "Je propose mon aide", "Je partage une compétence ou un peu de mon temps.", "heart"], ["request", "Je recherche de l’aide", "J’explique mon besoin à la communauté.", "people"]].each do |value, title, description, icon| %>
                <label class="listing-choice"><%= f.radio_button :intent, value %><span class="listing-choice-content"><span class="listing-choice-icon"><%= quest_icon(icon) %></span><strong><%= title %></strong><span><%= description %></span></span></label>
              <% end %></fieldset>
            <% elsif @step == 2 %>
              <fieldset class="listing-choices listing-choices-three"><legend class="sr-only">Mode d’échange</legend>
              <% [["gift", "Don", "Un service sans contrepartie.", "heart"], ["barter", "Échange", "Un savoir-faire contre un autre.", "link"], ["points", "Points Services", "Une estimation à convenir ensemble.", "trophy"]].each do |value, title, description, icon| %>
                <label class="listing-choice"><%= f.radio_button :exchange_mode, value, data: { action: "change->listing-wizard#exchange" } %><span class="listing-choice-content"><span class="listing-choice-icon"><%= quest_icon(icon) %></span><strong><%= title %></strong><span><%= description %></span></span></label>
              <% end %></fieldset>
              <div class="listing-points-field" data-listing-wizard-target="points"><%= input_field f, :estimated_points, "Estimation en Points Services", type: :number_field, min: 1, max: 999999, placeholder: "Exemple : 25" %><p>Cette estimation pourra être discutée avant de confirmer l’échange. <%= link_to "Consulter le barème indicatif", points_explanation_path, target: "_blank", rel: "noopener" %></p></div>
            <% else %>
              <p class="listing-example-note">Des exemples vous aident à démarrer. Adaptez le titre, la description et vos disponibilités avant de publier.</p>
              <%= input_field f, :title, "Titre", required: true, maxlength: 120 %>
              <div class="form-grid"><%= select_field f, :category_id, "Catégorie", @categories.map { |c| [c.lineage.reverse.map(&:name).join(" › "),c.id] }, include_blank: "Choisir une catégorie" %><%= select_field f, :service_location_mode, "Comment se déroule le service ?", choices_for(Listing.service_location_modes.keys) %></div>
              <%= input_field f, :description, "Description publique sans coordonnées", type: :text_area, required: true, rows: 5, maxlength: 5000 %>
              <div class="form-grid"><%= input_field f, :city, "Commune publique — inutile pour un service à distance", placeholder: "Exemple : Rennes" %><%= input_field f, :address_line, "Adresse exacte privée", placeholder: "Votre adresse, si le service se fait sur place" %></div>
              <p class="listing-address-note">L’adresse exacte reste privée et n’apparaît pas dans votre annonce. Pour un service à distance, aucune carte ni distance n’est affichée.</p>
              <div class="form-grid"><%= select_field f, :priority, "Priorité", [["Annonce classique", "standard"], ["Besoin urgent", "urgent"]] %><%= input_field f, :availability, "Disponibilités", maxlength: 1000, placeholder: "Exemple : mercredi et samedi" %></div>
              <div class="listing-upload"><span class="listing-choice-icon"><%= quest_icon("listing") %></span><%= input_field f, :photos, "Ajouter des photos", type: :file_field, multiple: true, accept: "image/jpeg,image/png,image/webp", data: { action: "change->listing-wizard#photos" } %><p>Jusqu’à 4 photos · JPEG, PNG ou WebP · 5 Mo chacune.<br>Évitez les coordonnées et les documents personnels.</p><p data-listing-wizard-target="files" aria-live="polite"></p></div>
              <div class="listing-preview-photos"><% @listing.photos.each do |photo| %><%= image_tag media_path(photo), alt: "Photo de votre brouillon", width: 400, height: 250 %><% end %></div>
            <% end %>
          </div>
          <div class="listing-wizard-actions"><% if @step > 1 %><%= link_to "← Précédent", edit_account_listing_path(@listing, step: @step - 1), class: "btn btn-outline" %><% else %><span class="btn btn-outline" aria-disabled="true">← Précédent</span><% end %><%= f.submit "Continuer →", class: "btn btn-deep" %></div>
        <% end %>
      <% else %>
        <div class="listing-wizard-body">
          <article class="listing-preview-card"><span class="eyebrow"><%= @listing.category&.name || "Catégorie à compléter" %></span><h2><%= @listing.title.presence || "Titre à compléter" %></h2><%= plain_paragraphs @listing.description %><div class="catalogue-facts"><span><%= human_value @listing.intent %></span><span><%= @listing.exchange_mode_points? ? "#{@listing.estimated_points} PS estimés" : human_value(@listing.exchange_mode) %></span><span><%= @listing.location_label.presence || "Commune à compléter" %></span></div><p><strong>Disponibilités :</strong> <%= @listing.availability.presence || "À convenir ensemble" %></p><div class="listing-preview-photos"><% @listing.photos.each do |photo| %><%= image_tag media_path(photo), alt: "Photo de votre annonce", width: 400, height: 250 %><% end %></div><%= link_to "Modifier les détails", edit_account_listing_path(@listing, step: 3) %></article>
        </div>
        <%= form_with url: transition_account_listing_path(@listing), method: :patch do |f| %>
          <div class="listing-wizard-consent"><%= hidden_field_tag :event, "publish" %><label><%= check_box_tag :privacy_confirmed, "1", false, required: true %><span>Les informations publiques et les photos ne contiennent pas mes coordonnées privées.</span></label><p>Votre annonce sera publiée après les vérifications prévues. <%= link_to "Confidentialité et données personnelles", privacy_preferences_path %></p></div>
          <div class="listing-wizard-actions"><%= link_to "← Précédent", edit_account_listing_path(@listing, step: 3), class: "btn btn-outline" %><%= f.submit "Publier mon annonce", class: "btn btn-deep" %></div>
        <% end %>
      <% end %>
    </section>
  </div>
</div>
