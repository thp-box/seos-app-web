<h1>Mes annonces</h1><p><%= link_to "Créer une annonce", new_account_listing_path, class: "btn btn-primary" %></p><% if @listings.empty? %><p>Votre première annonce commence ici.</p><% end %>
<% @listings.each do |listing| %><article class="card"><span class="badge"><%= human_value listing.status %></span><h2><%= listing.title.presence || "Nouvelle annonce" %></h2><%= link_to "Reprendre / modifier", edit_account_listing_path(listing, step: listing.wizard_step) %><% if listing.publicly_visible? %> · <%= link_to "Voir l’annonce", listing_path(listing) %><% end %><div class="actions"><% if listing.published? %><%= button_to "Mettre en pause", transition_account_listing_path(listing, event: "pause"), method: :patch %><% end %><% unless listing.removed? || listing.closed? %><%= button_to "Clôturer", transition_account_listing_path(listing, event: "close"), method: :patch %><%= button_to "Retirer", transition_account_listing_path(listing, event: "remove"), method: :patch %><% end %></div></article><% end %>
