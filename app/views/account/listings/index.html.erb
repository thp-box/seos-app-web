<%= account_page_heading "Mes annonces" %><p><%= link_to "Créer une annonce", new_account_listing_path, class: "btn btn-primary" %></p><% if @listings.empty? %><p>Votre première annonce commence ici.</p><% end %>
<div class="account-listing-grid"><% @listings.select(&:publicly_visible?).first(4).each do |listing| %><%= render "listings/card", listing: listing %><% end %></div>
<div class="account-table-wrap"><table class="account-management-table"><caption class="sr-only">Gestion de mes annonces</caption><thead><tr><th>Annonce</th><th>Statut</th><th>Actions</th></tr></thead><tbody>
<% @listings.each do |listing| %><tr><td><strong><%= listing.title.presence || "Nouvelle annonce" %></strong></td><td><span class="badge"><%= human_value listing.status %></span></td><td><div class="actions"><%= link_to "Reprendre / modifier", edit_account_listing_path(listing, step: listing.wizard_step), class: "btn btn-outline" %><% if listing.published? %><%= button_to "Mettre en pause", transition_account_listing_path(listing, event: "pause"), method: :patch, class: "btn btn-outline" %><% end %><% unless listing.removed? || listing.closed? %><%= button_to "Clôturer", transition_account_listing_path(listing, event: "close"), method: :patch, class: "btn btn-outline" %><%= button_to "Retirer", transition_account_listing_path(listing, event: "remove"), method: :patch, class: "btn btn-outline" %><% end %></div></td></tr><% end %>
</tbody></table></div>
<p class="account-note">Pour demander une mise en avant, retrouvez les conditions et le formulaire dans <%= link_to "Mes quêtes", account_community_path %>.</p>
