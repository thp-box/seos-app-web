<% listings = Catalogue.call({}).first(4) %><% if listings.empty? %><p>Aucune annonce disponible pour le moment.</p><% end %>
<% listings.each do |listing| %><article class="ad-card"><div class="ad-image"><% if listing.photos.attached? %><%= image_tag media_path(listing.photos.first), alt: listing.title, loading: "lazy" %><% end %></div><div class="ad-body"><span class="ad-badge"><%= human_value(listing.exchange_mode) %></span><h3><%= link_to listing.title, listing_path(listing) %></h3><p><%= truncate listing.description, length: 150 %></p><p><%= listing.location_label %></p><span><%= public_name(listing.user) %></span></div></article><% end %>
