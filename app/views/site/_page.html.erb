<%= render "site/edit_link", slug: slug %>
<% hero_template = page["blocks"].find { |block| !block["hidden"] && %w[home-0 don-0 exchange-0 points-0].include?(block["template"]) }&.fetch("template") %>
<div class="maquette-surface"><div class="page active" data-maquette-page="<%= hero_template ? hero_template.delete_suffix("-0") : slug %>">
  <% if page["blocks"].none? { |block| !block["hidden"] && SiteDesign.templates.fetch(block["template"])["html"].to_s.include?("<h1") } %><div class="container section"><h1><%= page["title"] %></h1></div><% end %>
  <% heading_used = false %>
  <% page["blocks"].reject { |block| block["hidden"] }.each do |block| %>
    <% if block["placement"] == "top" %><%= render "site/decoration", block: block %><% end %>
    <% if block["template"] == "text" %><section class="section"><div class="container"><h2><%= block["values"].fetch("title", "Votre titre") %></h2><%= plain_paragraphs block["values"].fetch("body", "Votre contenu") %><% if block["values"]["url"].present? && block["values"]["label"].present? %><%= link_to block["values"]["label"], block["values"]["url"], class: "btn btn-deep" %><% end %></div></section>
    <% else %><%= maquette_html SiteDesign.templates.fetch(block["template"])["html"], block: block, secondary_heading: heading_used %><% heading_used ||= SiteDesign.templates.fetch(block["template"])["html"].to_s.include?("<h1") %><% end %>
    <% unless block["placement"] == "top" %><%= render "site/decoration", block: block %><% end %>
  <% end %>
</div></div>
