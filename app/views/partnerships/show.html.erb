<% content_for :title, @partnership_page.title %>
<%= render "shared/public_hero", eyebrow: "SEOS et son réseau", title: @partnership_page.title, description: @partnership_page.introduction %>
<section class="container section partner-page" aria-labelledby="partner-page-title">
  <div class="partner-page-intro"><span class="account-eyebrow">Construire ensemble</span><h2 id="partner-page-title">Des structures engagées à nos côtés</h2><%= plain_paragraphs @partnership_page.body %></div>
  <% if @partnership_page.partner_entries.any? %><div class="partner-public-grid"><% @partnership_page.partner_entries.each do |partner| %><article class="partner-public-card">
    <a href="<%= partner.website_url %>" target="_blank" rel="external noopener noreferrer" aria-label="Visiter le site de <%= partner.title %>"><div class="partner-public-logo"><% if partner.logo.attached? %><%= image_tag media_path(partner.logo.attachment), alt: "Logo de #{partner.title}", width: 180, height: 110, loading: "lazy" %><% else %><span><%= partner.title.first.upcase %></span><% end %></div><h3><%= partner.title %></h3><%= plain_paragraphs partner.description %><span class="partner-public-link">Découvrir le partenaire <span aria-hidden="true">→</span></span></a>
  </article><% end %></div><% else %><p class="partner-public-empty">Les premiers partenaires seront présentés prochainement.</p><% end %>
  <% if @partnership_page.contact_label.present? && @partnership_page.contact_url.present? %><div class="partner-page-contact"><h2>Construisons quelque chose d’utile</h2><p>Vous souhaitez contribuer au réseau SEOS ?</p><%= link_to @partnership_page.contact_label, @partnership_page.contact_url, class: "btn btn-primary", rel: "external noopener noreferrer" %></div><% end %>
</section>
