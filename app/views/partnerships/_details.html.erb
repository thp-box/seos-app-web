<h2><%= record.public_title %></h2><p><%= record.organization.name %> · partenariat <%= network_label(record.kind).downcase %></p><% if record.starts_on && record.ends_on %><p>Du <%= l(record.starts_on) %> au <%= l(record.ends_on) %>.</p><% end %><% if record.logo.attached? %><%= image_tag media_path(record.logo.attachment), alt: "Logo de #{record.organization.name}", width: 160, height: 160, class: "organization-logo" %><% end %><%= plain_paragraphs(record.public_description) %><% if record.cta_url.present? && record.safe_link? %><%= link_to record.cta_label, record.cta_url, rel: "external noopener noreferrer", class: "btn btn-outline" %><% end %>
