<div class="card"><h3><%= record.persisted? ? "Modifier le partenariat" : "Proposer un partenariat" %></h3><%= form_with model: record, scope: :partnership, url: url, method: method, multipart: true do |form| %><%= hidden_field_tag :operation, "partnership", id: nil %><%= hidden_field_tag :record_id, record.id, id: nil %><%= hidden_field_tag :organization_id, record.organization_id, id: nil %><% prefix = "partnership-#{record.persisted? ? 'record' : 'new'}-#{record.id || record.organization_id}-" %>
<%= input_field form, :public_title, "Titre public", required: true, id: prefix + "title" %><%= input_field form, :public_description, "Présentation du partenariat", type: :text_area, id: prefix + "description" %><%= input_field form, :starts_on, "Début du partenariat", type: :date_field, id: prefix + "starts" %><%= input_field form, :ends_on, "Fin du partenariat", type: :date_field, id: prefix + "ends" %><%= input_field form, :cta_label, "Texte du lien facultatif", id: prefix + "label" %><%= input_field form, :cta_url, "Destination du lien (HTTPS)", type: :url_field, id: prefix + "url" %>
<% if admin %><%= input_field form, :position, "Ordre d’affichage", type: :number_field, min: 0, max: 1000, id: prefix + "position" %><% if current_user.super_admin? %><div class="form-field"><%= form.label :kind, "Type de partenariat", for: prefix + "kind" %><%= form.select :kind, network_choices(Partnership::KINDS), {}, id: prefix + "kind", class: "control" %></div><% end %><% end %>
<div class="form-field"><%= label_tag prefix + "logo", "Logo JPEG, PNG ou WebP (5 Mo maximum)" %><%= file_field_tag :logo, id: prefix + "logo", accept: "image/jpeg,image/png,image/webp", class: "control" %></div><%= form.button "Enregistrer le brouillon de partenariat", class: "btn btn-primary" %><% end %></div>
