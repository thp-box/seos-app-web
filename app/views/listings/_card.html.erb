<article class="card listing-card">
  <div class="actions"><span class="badge"><%= human_value(listing.intent) %></span><span class="badge"><%= human_value(listing.exchange_mode) %></span><% if listing.top_placement %><span class="badge">Top annonce</span><% end %>
    <% if listing.urgent? %><span class="badge">Urgent</span><% end %></div>
  <% if listing.photos.attached? %><%= image_tag media_path(listing.photos.first), alt: listing.title, loading: "lazy", width: 480, height: 300, class: "listing-photo" %><% end %>
  <p class="eyebrow"><%= listing.category&.name %></p><h2><%= link_to listing.title, listing_path(listing) %></h2>
  <p><%= truncate(listing.description, length: 150) %></p><p><%= listing.location_label %> · <%= human_value(listing.service_location_mode) %></p>
  <% if @search_coordinates && listing.public_coordinates %><p>À environ <%= Geocoder::Calculations.distance_between(@search_coordinates, listing.public_coordinates, units: :km).round %> km de la commune recherchée</p><% end %>
  <div class="card-meta"><span><%= public_name(listing.user) %></span><% if listing.exchange_mode_points? %><strong><%= listing.estimated_points %> PS estimés</strong><% end %></div>
</article>
